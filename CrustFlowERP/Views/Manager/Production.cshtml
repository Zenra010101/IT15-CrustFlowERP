@{
    ViewData["Title"] = "Operations Monitor";
    Layout = "_AdminSidebarLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Operations Monitor</h2>
            <p class="text-muted">Production efficiency and manufacturing status</p>
        </div>
        <a asp-controller="ProductionOrders" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-clipboard-list me-2"></i>Live Track Orders
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                        <i class="fas fa-microchip text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Production Workflow</h5>
                </div>
                <p class="text-muted small">Access core manufacturing settings including recipes and batch planning.</p>
                <div class="d-flex gap-2">
                    <a asp-controller="Recipes" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">View Recipes</a>
                    <a asp-controller="ProductionOrders" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">New Batch</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-info bg-opacity-10 p-3 rounded-4 me-3">
                        <i class="fas fa-vial text-info"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Quality Control</h5>
                </div>
                <p class="text-muted small">Monitor wastage reports and quality check compliance levels.</p>
                <div class="d-flex gap-2">
                    <a asp-controller="QualityControl" asp-action="Index" class="btn btn-outline-info btn-sm rounded-pill px-3">QC Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>
