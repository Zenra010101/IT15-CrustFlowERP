@model IEnumerable<CrustFlowERP.Models.CRM.Customer>
@{
    ViewData["Title"] = "Customers Management";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div class="page-title-box">
                <h3 class="mb-0 fw-bold"><i class="fas fa-users me-2 text-primary"></i> Customers Management</h3>
                <p class="text-muted">Manage your customer relationships and loyalty programs.</p>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                    <i class="fas fa-plus me-2"></i> Add Customer
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 5px solid #0d6efd;">
                <div class="card-body py-3">
                    <div class="small text-muted mb-1">Total Customers</div>
                    <div class="h4 mb-0 fw-bold text-primary">@Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 5px solid #198754;">
                <div class="card-body py-3">
                    <div class="small text-muted mb-1">Retail Customers</div>
                    <div class="h4 mb-0 fw-bold text-success">@Model.Count(c => c.CustomerType == "Retail")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 5px solid #f39c12;">
                <div class="card-body py-3">
                    <div class="small text-muted mb-1">Wholesale Partners</div>
                    <div class="h4 mb-0 fw-bold text-warning">@Model.Count(c => c.CustomerType == "Wholesale")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Customer Name</th>
                            <th>Category</th>
                            <th>Contact Info</th>
                            <th>Loyalty Points</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-subtle p-2 rounded-2 me-3">
                                            <i class="fas fa-user text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@customer.Name</div>
                                            <small class="text-muted">ID: #CUS-@customer.Id.ToString("D4")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(customer.CustomerType == "Wholesale" ? "bg-warning-subtle text-warning border-warning-subtle" : "bg-info-subtle text-info border-info-subtle") fw-normal rounded-pill px-3 py-2 border">
                                        @customer.CustomerType
                                    </span>
                                </td>
                                <td>
                                    <div><i class="fas fa-phone-alt small me-2 text-muted"></i>@customer.Phone</div>
                                    <div><i class="fas fa-envelope small me-2 text-muted"></i>@customer.Email</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@customer.LoyaltyPoints</span> pts
                                </td>
                                <td>
                                    @if (customer.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-medium">
                                            <i class="fas fa-check-circle me-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-medium">
                                            <i class="fas fa-times-circle me-1"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No customers found. Click "Add Customer" to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1); }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1); }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1); }
    .bg-info-subtle { background-color: rgba(13, 202, 240, 0.1); }
    .border-warning-subtle { border-color: rgba(255, 193, 7, 0.2) !important; }
    .border-info-subtle { border-color: rgba(13, 202, 240, 0.2) !important; }
</style>
