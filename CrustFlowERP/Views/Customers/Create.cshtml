@model CrustFlowERP.Models.CRM.Customer
@{
    ViewData["Title"] = "Add Customer";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="fw-bold"><i class="fas fa-user-plus text-primary me-2"></i> Register New Customer</h3>
            <p class="text-muted">Create a new customer profile for sales and tracking.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Customer Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Full Name or Business Name" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Customer Type</label>
                                <select asp-for="CustomerType" class="form-select">
                                    <option value="Retail">Retail</option>
                                    <option value="Wholesale">Wholesale</option>
                                    <option value="VIP">VIP</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Phone Number</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Email Address</label>
                                <input asp-for="Email" class="form-control" type="email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Physical Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 rounded-pill">Create Customer</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
