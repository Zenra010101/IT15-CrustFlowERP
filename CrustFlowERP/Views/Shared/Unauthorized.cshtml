@{
    ViewData["Title"] = "Unauthorized Access";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🚫 Unauthorized Access</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div style="font-size: 4rem;">🔒</div>
                    </div>
                    <h5 class="card-title text-center">You don't have permission to access this page.</h5>
                    <p class="card-text text-center">
                        Your current role doesn't have the necessary permissions to view this content.
                        Please contact your system administrator if you believe this is an error.
                    </p>
                    <div class="text-center">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            ← Back to Dashboard
                        </a>
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-secondary ms-2">
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
