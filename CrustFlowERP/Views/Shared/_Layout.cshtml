<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrustFlowERP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CrustFlowERP.styles.css" asp-append-version="true" />
    <style>
        /* Responsive navbar improvements */
        .navbar-brand {
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }
        
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        
        .navbar-brand:hover img {
            transform: scale(1.1);
        }
        
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1rem;
            }
            
            .navbar-brand img {
                max-width: 25px;
                margin-right: 8px;
            }
            
            .container {
                padding-left: 15px;
                padding-right: 15px;
            }
        }
        
        @@media (max-width: 576px) {
            .navbar-brand {
                font-size: 0.9rem;
            }
            
            .navbar-brand img {
                max-width: 20px;
                margin-right: 5px;
            }
        }
        
        /* Responsive footer */
        .footer {
            padding: 1rem 0;
            text-align: center;
        }
        
        @@media (max-width: 768px) {
            .footer {
                font-size: 0.9rem;
            }
        }
        
        /* Responsive main container */
        .container {
            max-width: 100%;
            padding-left: 15px;
            padding-right: 15px;
        }
        
        @@media (min-width: 1200px) {
            .container {
                max-width: 1140px;
            }
        }
        
        @@media (min-width: 1400px) {
            .container {
                max-width: 1320px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom box-shadow mb-3" style="background-color: #f5e6d3;">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index" style="color: #8b5a2b; font-weight: bold;">
                    <img src="~/images/crustflow-logo.png" alt="CrustFlow Logo" style="max-width: 30px; height: auto; margin-right: 10px;" />
                    <span class="d-none d-sm-inline">CrustFlowERP</span>
                    <span class="d-sm-none">CF</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    &copy; 2026 - CrustFlowERP - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
