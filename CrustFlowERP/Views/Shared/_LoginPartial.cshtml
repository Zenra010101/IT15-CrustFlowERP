@using Microsoft.AspNetCore.Identity
@using CrustFlowERP.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link" style="color: #8b5a2b;" title="Manage">Hello @User.Identity?.Name!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Login", "Account")">
            <button type="submit" class="nav-link btn btn-link" style="color: #8b5a2b;">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" style="color: #8b5a2b;" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
