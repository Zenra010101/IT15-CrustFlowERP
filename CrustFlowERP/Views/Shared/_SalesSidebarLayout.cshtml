@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrustFlowERP Sales</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        /* Sales-specific sidebar styles */
        .sales-wrapper {
            display: flex;
            min-height: 100vh;
        }
        
        .sales-sidebar {
            width: 250px;
            background: linear-gradient(135deg, #6610f2 0%, #6f42c1 100%);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }
        
        .sales-content {
            margin-left: 250px;
            flex: 1;
            background: #f8f9fa;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }
        
        @@media (max-width: 992px) {
            .sales-sidebar {
                transform: translateX(-100%);
            }
            
            .sales-sidebar.active {
                transform: translateX(0);
            }
            
            .sales-content {
                margin-left: 0;
            }
        }
        
        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .sidebar-brand {
            color: white;
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        
        .sidebar-brand i {
            margin-right: 10px;
        }
        
        .menu-link {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }
        
        .menu-link:hover {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }
        
        .menu-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.2);
        }
        
        .menu-icon {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }
        
        .mobile-toggle {
            display: none;
            position: fixed;
            top: 15px;
            left: 15px;
            z-index: 1001;
            background: #6610f2;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 10px;
            cursor: pointer;
        }
        
        @@media (max-width: 992px) {
            .mobile-toggle {
                display: block;
            }
        }
        
        .content-header {
            background: white;
            padding: 20px;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 20px;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #6610f2;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }
        
        @@media (max-width: 992px) {
            .overlay.active {
                display: block;
            }
        }
    </style>
</head>
<body>
    <button class="mobile-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>
    
    <div class="overlay" onclick="toggleSidebar()"></div>
    
    <div class="sales-wrapper">
        <nav class="sales-sidebar" id="sidebar">
            @{
                var roleId = Context.Session.GetInt32("UserRole") ?? 0;
                var roleName = Context.Session.GetString("UserRoleName") ?? "User";
                var userEmail = Context.Session.GetString("UserEmail") ?? "";
            }

            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-tags"></i> 
                    <span class="d-none d-sm-inline">Sales & Retail</span>
                </a>
            </div>

            <ul class="sidebar-menu list-unstyled py-2">
                <li class="menu-item">
                    <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                       href="@(roleId == 8 ? Url.Action("Index", "Cashier") : Url.Action("Index", "SalesManager"))">
                        <span class="menu-icon"><i class="fas fa-tachometer-alt"></i></span>
                        Dashboard
                    </a>
                </li>

                @if (roleId == 8 || roleId <= 2 || roleId == 11) // Cashier or Admin
                {
                    <li class="menu-item">
                        <small class="text-uppercase text-white-50 px-4 mt-3 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 1px;">Cashier Tasks</small>
                    </li>
                    <li class="menu-item">
                        <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProcessSales" ? "active" : "")" asp-controller="Cashier" asp-action="ProcessSales">
                            <span class="menu-icon"><i class="fas fa-cash-register"></i></span>
                            Process Sales (POS)
                        </a>
                    </li>
                    <li class="menu-item">
                        <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PrintReceipts" ? "active" : "")" asp-controller="Cashier" asp-action="PrintReceipts">
                            <span class="menu-icon"><i class="fas fa-print"></i></span>
                            Print Receipts
                        </a>
                    </li>
                    <li class="menu-item">
                        <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ViewStock" ? "active" : "")" asp-controller="Cashier" asp-action="ViewStock">
                            <span class="menu-icon"><i class="fas fa-boxes"></i></span>
                            Available Stock
                        </a>
                    </li>
                }

                @if (roleId == 9 || roleId <= 2 || roleId == 11) // Sales Manager or Admin
                {
                    <li class="menu-item">
                        <small class="text-uppercase text-white-50 px-4 mt-3 mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 1px;">Sales Management</small>
                    </li>
                    <li class="menu-item">
                        <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SalesReports" ? "active" : "")" asp-controller="SalesManager" asp-action="SalesReports">
                            <span class="menu-icon"><i class="fas fa-chart-line"></i></span>
                            Sales Reports
                        </a>
                    </li>

                    <li class="menu-item">
                        <a class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProductionCoordination" ? "active" : "")" asp-controller="SalesManager" asp-action="ProductionCoordination">
                            <span class="menu-icon"><i class="fas fa-handshake"></i></span>
                            Coord. with Production
                        </a>
                    </li>
                }

                <li class="menu-item mt-auto">
                    <hr class="mx-3 border-light opacity-25">
                    <a class="menu-link text-danger" href="#" onclick="logoutUser()">
                        <span class="menu-icon text-danger"><i class="fas fa-sign-out-alt"></i></span>
                        Logout
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sales-content">
            <header class="content-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="user-info">
                            <div class="user-avatar">
                                @(string.IsNullOrEmpty(userEmail) ? "U" : userEmail.Substring(0, 1).ToUpper())
                            </div>
                            <div class="d-none d-md-block">
                                <div class="fw-bold">@roleName</div>
                                <small class="text-muted">@userEmail</small>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: none;">
                @Html.AntiForgeryToken()
            </form>

            <main class="p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
            document.querySelector('.overlay').classList.toggle('active');
        }
        function logoutUser() {
            if (confirm("Are you sure you want to logout?")) {
                document.getElementById('logoutForm').submit();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
