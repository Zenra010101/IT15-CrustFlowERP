@{
    ViewData["Title"] = "Production Coordination";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h2 class="display-6"><i class="fas fa-handshake me-2 text-indigo"></i>Production Coordination</h2>
            <p class="text-muted">Communicate sales requirements and backlog to the production team.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Production Requests</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Request ID</th>
                                    <th>Product</th>
                                    <th>Quantity Needed</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No active production requests.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @if (Context.Session.GetInt32("UserRole") != 11)
        {
            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-3 p-4">
                    <h5>Send New Request</h5>
                    <form class="mt-4">
                        <div class="mb-3">
                            <label class="form-label">Product</label>
                            <select class="form-select">
                                <option selected disabled>Choose a product...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control" placeholder="0">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Priority</label>
                            <div class="d-flex gap-2">
                                <input type="radio" class="btn-check" name="priority" id="low" autocomplete="off">
                                <label class="btn btn-outline-success flex-grow-1" for="low">Low</label>

                                <input type="radio" class="btn-check" name="priority" id="med" autocomplete="off" checked>
                                <label class="btn btn-outline-warning flex-grow-1" for="med">Medium</label>

                                <input type="radio" class="btn-check" name="priority" id="high" autocomplete="off">
                                <label class="btn btn-outline-danger flex-grow-1" for="high">High</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-indigo w-100 rounded-pill mt-3 text-white">Send to Production</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-3 p-4 bg-light">
                    <div class="text-center py-5">
                        <i class="fas fa-lock fa-3x text-muted mb-3 opacity-25"></i>
                        <h5 class="text-muted">Read-Only Monitoring</h5>
                        <p class="small text-muted px-4">The General Manager role has restricted access to department-level production requests.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .btn-indigo { background: #6610f2; border-color: #6610f2; }
    .btn-indigo:hover { background: #5a0cd1; border-color: #5a0cd1; }
    .text-indigo { color: #6610f2; }
</style>
