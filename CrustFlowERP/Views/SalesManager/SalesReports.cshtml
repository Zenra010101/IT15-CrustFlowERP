@{
    ViewData["Title"] = "Sales Performance";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h2 class="display-6"><i class="fas fa-chart-line me-2 text-indigo"></i>Sales Performance</h2>
            <p class="text-muted">Analyze sales data and performance metrics.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Daily Revenue</p>
                <h2 class="text-indigo fw-bold mt-2">₱@(((decimal)ViewBag.DailyRevenue).ToString("N2"))</h2>
                <span class="@(ViewBag.RevenueGrowth >= 0 ? "text-success" : "text-danger") small">
                    <i class="fas @(ViewBag.RevenueGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i> 
                    @(((decimal)ViewBag.RevenueGrowth).ToString("F1"))% vs yesterday
                </span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Weekly Sales Count</p>
                <h2 class="text-indigo fw-bold mt-2">@ViewBag.WeeklySalesCount</h2>
                <span class="text-muted small">Orders this week</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Avg Order Value</p>
                <h2 class="text-indigo fw-bold mt-2">₱@(((decimal)ViewBag.AvgOrderValue).ToString("N2"))</h2>
                <span class="text-muted small">Last 30 days</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Revenue Trend (Last 7 Days)</h5>
        </div>
        <div class="card-body py-4">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in ViewBag.TrendData)
                        {
                            <tr>
                                <td>@day.Date.ToString("MMM dd, yyyy")</td>
                                <td class="text-end fw-bold">₱@day.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .text-indigo { color: #6610f2; }
</style>
