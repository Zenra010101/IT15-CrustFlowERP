@model CrustFlowERP.Models.Production.Product

@{
    ViewData["Title"] = "Add New Product";
    Layout = "_AdminSidebarLayout";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Product Catalog</a></li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </nav>
            <h2 class="fw-bold">Add New Product</h2>
            <p class="text-muted">Register a new item in your bakery's inventory</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" class="form-control rounded-pill border-light bg-light" placeholder="e.g. Panda Bread" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select rounded-pill border-light bg-light" required>
                                    <option value="">-- Select Category --</option>
                                    <option value="Bread">Bread</option>
                                    <option value="Pastry">Pastry</option>
                                    <option value="Cake">Cake</option>
                                    <option value="Beverage">Beverage</option>
                                    <option value="Others">Others</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text rounded-start-pill border-light bg-light">₱</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control rounded-end-pill border-light bg-light" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end mb-2">
                                <div class="form-check form-switch bg-light p-2 px-4 rounded-pill w-100">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                                    <label class="form-check-label fw-bold ms-2" asp-for="IsActive">Product is Active</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label fw-bold">Initial Stock</label>
                                <input asp-for="StockQuantity" type="number" step="0.01" class="form-control rounded-pill border-light bg-light" placeholder="0.00" required />
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MinStockLevel" class="form-label fw-bold">Low Stock Warning At</label>
                                <input asp-for="MinStockLevel" type="number" step="0.01" class="form-control rounded-pill border-light bg-light" placeholder="0.00" required />
                                <span asp-validation-for="MinStockLevel" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <textarea asp-for="Description" class="form-control rounded-4 border-light bg-light" rows="3" placeholder="Enter product description and details..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label fw-bold text-primary"><i class="fas fa-image me-2"></i>Product Image</label>
                                <input type="hidden" asp-for="ImageUrl" id="hiddenImageUrl" />
                                <div class="p-4 border-2 border-dashed rounded-4 text-center bg-light transition-all" id="dropZone">
                                    <input type="file" name="imageFile" id="imageFile" class="form-control d-none" accept="image/*" onchange="uploadImage(this)">
                                    <div id="uploadPlaceholder">
                                        <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                                        <p class="mb-2 fw-bold">Click or drag image to upload</p>
                                        <p class="text-muted small mb-0">Supported formats: JPG, PNG, WEBP (Max 5MB)</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-3 rounded-pill" onclick="document.getElementById('imageFile').click()">Browse Files</button>
                                    </div>
                                    <div id="uploadingState" class="d-none py-4">
                                        <div class="spinner-border text-primary mb-2" role="status"></div>
                                        <p class="mb-0 fw-bold">Uploading to Cloud...</p>
                                    </div>
                                    <div id="imagePreviewContainer" class="d-none">
                                        <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm mb-3" style="max-height: 200px;">
                                        <div>
                                            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" onclick="clearPreview()">
                                                <i class="fas fa-trash me-1"></i> Change Image
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold" id="btnSave">
                                <i class="fas fa-save me-2"></i> Save Product
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-info-circle me-2"></i> Quick Tip</h5>
                    <p class="opacity-75">When adding a new product, make sure to categorize it correctly to help with inventory tracking and sales reporting.</p>
                    <hr class="opacity-25" />
                    <p class="small mb-0">Once created, you can add <strong>Recipes</strong> and <strong>Ingredients</strong> through the product details view to enable automatic stock deduction.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function uploadImage(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                
                // Show uploading state
                $('#uploadPlaceholder').addClass('d-none');
                $('#uploadingState').removeClass('d-none');
                $('#btnSave').prop('disabled', true);

                const formData = new FormData();
                formData.append('imageFile', file);

                fetch('/api/ProductsApi/upload-image', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        $('#hiddenImageUrl').val(data.imageUrl);
                        $('#imagePreview').attr('src', data.imageUrl);
                        $('#uploadingState').addClass('d-none');
                        $('#imagePreviewContainer').removeClass('d-none');
                    } else {
                        alert('Upload failed: ' + data.message);
                        clearPreview();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred during upload.');
                    clearPreview();
                })
                .finally(() => {
                    $('#btnSave').prop('disabled', false);
                });
            }
        }

        function clearPreview() {
            $('#imageFile').val('');
            $('#hiddenImageUrl').val('');
            $('#uploadPlaceholder').removeClass('d-none');
            $('#uploadingState').addClass('d-none');
            $('#imagePreviewContainer').addClass('d-none');
        }
    </script>
}
