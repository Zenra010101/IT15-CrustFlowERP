@model CrustFlowERP.Models.Production.Product

@{
    ViewData["Title"] = "Product Details";
    Layout = "_AdminSidebarLayout";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Product Catalog</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">@Model.Name</h2>
            <p class="text-muted">Master product configuration and recipe</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-edit me-2"></i> Edit Product
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Product Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="bg-light d-inline-block p-4 rounded-circle mb-3">
                            <i class="fas fa-bread-slice fa-4x text-warning opacity-75"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.Name</h4>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") rounded-pill px-3 py-2">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="list-group list-group-flush border-top pt-3">
                        <div class="p-2 d-flex justify-content-between">
                            <span class="text-muted">Category</span>
                            <span class="fw-bold border-bottom border-primary text-primary">@Model.Category</span>
                        </div>
                        <div class="p-2 d-flex justify-content-between">
                            <span class="text-muted">Price</span>
                            <span class="fw-bold h5 mb-0">₱@Model.Price.ToString("N2")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-4">
                            <h6 class="fw-bold text-uppercase small text-muted mb-2">Description</h6>
                            <p class="text-secondary small mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recipe & Ingredients -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fas fa-list-check text-primary me-2"></i> Standard Recipe</h5>
                    <a href="@Url.Action("Create", "Recipes", new { productId = Model.Id })" class="btn btn-sm btn-soft-primary rounded-pill px-3 fw-bold">
                        <i class="fas fa-plus me-1"></i> Add Ingredient
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Ingredient</th>
                                    <th>Quantity per Unit</th>
                                    <th class="pe-4 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Recipes != null && Model.Recipes.Any())
                                {
                                    foreach (var recipe in Model.Recipes)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@recipe.Ingredient?.Name</div>
                                                <small class="text-muted">@recipe.Ingredient?.Category</small>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-primary">@recipe.QuantityRequired.ToString("N2")</span>
                                                <small class="text-muted">@recipe.Ingredient?.Unit</small>
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a href="@Url.Action("Edit", "Recipes", new { id = recipe.Id })" class="btn btn-sm btn-light rounded-circle shadow-sm"><i class="fas fa-edit text-muted"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <i class="fas fa-mortar-pestle fa-3x opacity-25 mb-3 d-block"></i>
                                            <p class="text-muted mb-0">No ingredients defined for this recipe yet.</p>
                                            <small class="text-muted">Ingredients serve as the basis for stock deduction during production.</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-soft-primary { background-color: rgba(13, 110, 253, 0.1); color: #0d6efd; }
    .btn-soft-primary:hover { background-color: #0d6efd; color: #fff; }
</style>
