@using CrustFlowERP.Models.Purchasing
@{
    ViewData["Title"] = "Purchasing Dashboard";
    var stats = ViewBag.Stats;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Purchasing & Procurement</h2>
            <p class="text-muted">Manage supplier relations and ingredient procurement.</p>
        </div>
        <div class="col-auto">
            <!-- Header button removed as per user request -->
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="fas fa-clock text-info fa-lg"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold d-block">Pending POs</small>
                        <h3 class="fw-bold text-dark mb-0">@stats.TotalPending</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="fas fa-shipping-fast text-primary fa-lg"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold d-block">Ordered</small>
                        <h3 class="fw-bold text-dark mb-0">@stats.TotalOrdered</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
             <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="fas fa-truck-loading text-success fa-lg"></i>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-bold d-block">Procurement Status</small>
                            <h5 class="fw-bold text-dark mb-0">All systems operational</h5>
                        </div>
                    </div>
                    <a asp-action="PurchaseOrders" class="btn btn-sm btn-outline-secondary rounded-pill px-3">View All POs</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row g-4">
        <!-- Main Column -->
        <div class="col-lg-8">
            <!-- Low Stock Alerts -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-header bg-transparent py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Low Stock Alerts</h5>
                    <span class="badge bg-danger rounded-pill px-3">@(((IEnumerable<dynamic>)stats.LowStockAlerts).Count()) Items</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="ps-4">Ingredient</th>
                                <th class="text-center">Current Stock</th>
                                <th class="text-center">Min. Level</th>
                                <th class="text-center">Status</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in (IEnumerable<dynamic>)stats.LowStockAlerts)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@alert.Name</td>
                                    <td class="text-center">@alert.CurrentStock.ToString("N0") @alert.Unit</td>
                                    <td class="text-center text-muted">@alert.MinimumStockLevel.ToString("N0") @alert.Unit</td>
                                    <td class="text-center">
                                        <span class="text-danger fw-bold"><i class="fas fa-arrow-down-long me-1"></i> Stock Critically Low</span>
                                    </td>
                                    <td class="text-center pe-4">
                                        @if (Context.Session.GetInt32("UserRole") != 11)
                                        {
                                            <a asp-action="CreatePurchaseOrder" class="btn btn-sm btn-primary rounded-pill px-3">Order More</a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Read-only Monitoring</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!((IEnumerable<dynamic>)stats.LowStockAlerts).Any())
                            {
                                <tr>
                                    <td colspan="5" class="py-4 text-center text-muted">All ingredients are well supplied.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent py-3 border-0">
                    <h5 class="fw-bold text-dark mb-0">Recent Purchase Orders</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">PO Number</th>
                                <th>Supplier</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in (IEnumerable<PurchaseOrder>)stats.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@order.OrderNumber</td>
                                    <td>@order.Supplier?.Name</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end fw-bold">₱@order.TotalAmount.ToString("N2")</td>
                                    <td class="text-center pe-4">
                                        @{
                                            string statusClass = order.Status switch
                                            {
                                                PurchaseOrderStatus.Draft => "bg-secondary bg-opacity-10 text-secondary border-secondary",
                                                PurchaseOrderStatus.Pending => "bg-info bg-opacity-10 text-info border-info",
                                                PurchaseOrderStatus.Ordered => "bg-primary bg-opacity-10 text-primary border-primary",
                                                PurchaseOrderStatus.Received => "bg-success bg-opacity-10 text-success border-success",
                                                PurchaseOrderStatus.Cancelled => "bg-danger bg-opacity-10 text-danger border-danger",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge border rounded-pill px-3 py-1 @statusClass">@order.Status</span>
                                    </td>
                                </tr>
                            }
                            @if (!((IEnumerable<PurchaseOrder>)stats.RecentOrders).Any())
                            {
                                <tr>
                                    <td colspan="5" class="py-5 text-center text-muted">No recent orders found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4">Quick Actions</h5>
                    <div class="d-grid gap-3">
                        <a asp-action="CreatePurchaseOrder" class="btn btn-light border d-flex align-items-center justify-content-between p-3 rounded-3 shadow-none">
                            <span><i class="fas fa-plus me-2"></i> Create PO</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                        <a asp-controller="Suppliers" asp-action="Index" class="btn btn-light d-flex align-items-center justify-content-between p-3 rounded-3 border">
                            <span><i class="fas fa-truck me-2"></i> Manage Suppliers</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                        <a asp-action="Wastage" class="btn btn-light d-flex align-items-center justify-content-between p-3 rounded-3 border">
                            <span class="text-danger fw-bold"><i class="fas fa-trash-can me-2"></i> Record Wastage</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                        <a asp-controller="Ingredients" asp-action="Index" class="btn btn-light d-flex align-items-center justify-content-between p-3 rounded-3 border">
                            <span><i class="fas fa-leaf me-2"></i> View Ingredients</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Supplier Highlights -->
            <div class="card border-0 shadow-sm rounded-4 bg-primary bg-opacity-10">
                <div class="card-body p-4">
                    <h6 class="text-primary fw-bold text-uppercase mb-3 small">Supplier Notice</h6>
                    <p class="small text-dark mb-0">
                        Regularly update supplier pricing to ensure accurate procurement budgeting. Check "Manage Suppliers" for outdated contacts.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
