@model IEnumerable<CrustFlowERP.Models.Purchasing.PurchaseOrder>
@using CrustFlowERP.Models.Purchasing

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Purchase Orders</h2>
            <p class="text-muted">Monitor ingredient procurement and supply chain.</p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">PO Number</th>
                        <th class="py-3">Supplier</th>
                        <th class="py-3">Order Date</th>
                        <th class="py-3">Expected Date</th>
                        <th class="py-3 text-end">Total Amount</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark">@order.OrderNumber</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@order.Supplier?.Name</div>
                                <div class="small text-muted">@order.Supplier?.Category</div>
                            </td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>@(order.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td class="text-end">
                                <span class="fw-bold text-dark">₱@order.TotalAmount.ToString("N2")</span>
                            </td>
                            <td class="text-center">
                                @{
                                    string statusClass = order.Status switch
                                    {
                                        PurchaseOrderStatus.Draft => "bg-secondary bg-opacity-10 text-secondary border-secondary",
                                        PurchaseOrderStatus.Pending => "bg-info bg-opacity-10 text-info border-info",
                                        PurchaseOrderStatus.Ordered => "bg-primary bg-opacity-10 text-primary border-primary",
                                        PurchaseOrderStatus.Received => "bg-success bg-opacity-10 text-success border-success",
                                        PurchaseOrderStatus.PartiallyReceived => "bg-warning bg-opacity-10 text-warning border-warning",
                                        PurchaseOrderStatus.Cancelled => "bg-danger bg-opacity-10 text-danger border-danger",
                                        _ => "bg-light text-dark"
                                    };
                                }
                                <span class="badge border rounded-pill px-3 py-1 @statusClass">@order.Status</span>
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary border-0 rounded-pill px-3">
                                        <i class="fas fa-search-plus me-1"></i> Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-5 text-center text-muted">
                                <i class="fas fa-shopping-basket fa-3x opacity-25 mb-3 d-block"></i>
                                No purchase orders found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
