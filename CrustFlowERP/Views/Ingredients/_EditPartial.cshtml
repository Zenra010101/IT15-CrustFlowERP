@model CrustFlowERP.Models.Production.Ingredient

<div class="modal-header border-0 pb-0">
    <h5 class="modal-title fw-bold">
        <i class="fas fa-edit text-primary me-2"></i> Edit Ingredient
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Edit" method="post">
    <div class="modal-body pt-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Ingredient Name</label>
                <input asp-for="Name" class="form-control border-0 bg-light" required style="border-radius: 10px; height: 45px;">
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Minor Category</label>
                <select asp-for="Category" class="form-select border-0 bg-light" asp-items="Html.GetEnumSelectList<CrustFlowERP.Models.SupplyCategory>()" style="border-radius: 10px; height: 45px;">
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Inventory Category (Major)</label>
                <select asp-for="InventoryCategory" class="form-select border-0 bg-light" asp-items="Html.GetEnumSelectList<CrustFlowERP.Models.InventoryCategory>()" style="border-radius: 10px; height: 45px;">
                </select>
                <span asp-validation-for="InventoryCategory" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Unit of Measure</label>
                <select asp-for="Unit" class="form-select border-0 bg-light" style="border-radius: 10px; height: 45px;">
                    <option value="kg">Kilograms (kg)</option>
                    <option value="g">Grams (g)</option>
                    <option value="liters">Liters (L)</option>
                    <option value="ml">Milliliters (mL)</option>
                    <option value="pcs">Pieces (pcs)</option>
                    <option value="bags">Bags</option>
                    <option value="boxes">Boxes</option>
                </select>
                <span asp-validation-for="Unit" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Minimum Stock Level</label>
                <input asp-for="MinimumStockLevel" type="number" step="0.0001" class="form-control border-0 bg-light" style="border-radius: 10px; height: 45px;">
                <span asp-validation-for="MinimumStockLevel" class="text-danger small"></span>
            </div>



            <div class="col-md-6">
                <label class="form-label fw-bold">Status</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                    <label class="form-check-label" asp-for="IsActive">Active Ingredient</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-bold">Description (Optional)</label>
                <textarea asp-for="Description" class="form-control border-0 bg-light" rows="3" style="border-radius: 10px;"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
            Save Changes <i class="fas fa-check ms-2"></i>
        </button>
    </div>
</form>
