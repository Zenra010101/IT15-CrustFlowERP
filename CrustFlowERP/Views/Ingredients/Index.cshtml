@model IEnumerable<CrustFlowERP.Models.Production.Ingredient>

@{
    ViewData["Title"] = "Ingredients";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Ingredients Master</h2>
            <p class="text-muted">Manage raw materials and supply units</p>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm fw-bold rounded-pill">
                <i class="fas fa-plus me-2"></i> Add Ingredient
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Ingredient</th>
                            <th>Minor Category</th>
                            <th>Inventory Category</th>
                            <th>Current Stock</th>
                            <th>Target Stock</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted">ID: @item.Id</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark fw-normal rounded-pill px-3 border">
                                        @item.Category
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info fw-normal rounded-pill px-3 border">
                                        @item.InventoryCategory
                                    </span>
                                </td>
                                <td>
                                    @if(item.Inventories != null && item.Inventories.Any(inv => inv.Category == CrustFlowERP.Models.InventoryCategory.RawMaterials))
                                    {
                                        decimal currentStock = item.Inventories
                                            .Where(inv => inv.Category == CrustFlowERP.Models.InventoryCategory.RawMaterials)
                                            .Sum(inv => inv.RemainingQuantity);
                                        string stockColor = currentStock < item.MinimumStockLevel ? "text-danger fw-bold" : "text-success fw-bold";
                                        <div class="@stockColor">@currentStock.ToString("N2") @item.Unit</div>
                                    }
                                    else
                                    {
                                        <div class="text-danger fw-bold">0.00 @item.Unit</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium text-primary">@item.MinimumStockLevel.ToString("N2") @item.Unit</div>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive) {
                                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-medium">
                                            <i class="fas fa-check-circle me-1 small"></i> Active
                                        </span>
                                    } else {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-medium">
                                            <i class="fas fa-times-circle me-1 small"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button class="btn btn-sm btn-white border shadow-sm rounded-pill px-3" onclick="openEditModal(@item.Id)">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal Structure -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="modalContent" style="border-radius: 20px;">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1); }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1); }
    .table thead th { font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; opacity: 0.7; }
    .btn-white { background: white; color: #495057; }
    .btn-white:hover { background: #f8f9fa; color: #212529; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function openEditModal(id) {
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            document.getElementById('modalContent').innerHTML = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>`;
            modal.show();

            fetch(`/Ingredients/GetEditContent/${id}`)
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContent').innerHTML = html;
                    
                    // Re-initialize validation if needed
                    const form = document.querySelector('#modalContent form');
                    if (form && window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator.unobtrusive.parse(form);
                    }
                })
                .catch(err => {
                    console.error('Error loading edit content:', err);
                    document.getElementById('modalContent').innerHTML = `
                        <div class="modal-body text-center py-4">
                            <i class="fas fa-exclamation-triangle text-danger fa-3x mb-3"></i>
                            <p class="mb-0">Failed to load ingredient details.</p>
                            <small class="text-muted">${err.message}</small>
                        </div>`;
                });
        }
    </script>
}
