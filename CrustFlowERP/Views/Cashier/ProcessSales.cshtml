@model IEnumerable<CrustFlowERP.Models.Production.Product>
@{
    ViewData["Title"] = "Point of Sale";
}

<div class="pos-layout">
    <!-- Products Panel -->
    <div class="products-panel">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center sticky-top rounded-top-4">
                <h5 class="fw-bold mb-0">Products Catalog</h5>
                <div class="input-group w-50">
                    <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="productSearch" class="form-control bg-light border-0" placeholder="Search products...">
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3" id="productGrid">
                    @foreach (var product in Model)
                    {
                        <div class="col-md-4 col-xl-3 product-item" data-name="@product.Name.ToLower()">
                            <div class="card h-100 border-light shadow-sm product-card" onclick="addToCart(@product.Id, '@product.Name', @product.Price, @product.StockQuantity)">
                                <div class="card-body p-3 text-center">
                                    <div class="product-image-wrapper mb-3 overflow-hidden rounded-3 shadow-sm" style="height: 120px; background: #fefefe; border: 1px solid #eee;">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover; transition: transform 0.5s ease;" alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                                                <i class="fas fa-bread-slice fa-3x text-warning opacity-50"></i>
                                            </div>
                                        }
                                    </div>
                                    <h6 class="fw-bold mb-1 text-truncate">@product.Name</h6>
                                    <div class="text-primary fw-bold mb-1">₱@product.Price.ToString("N2")</div>
                                    <div class="badge @(product.StockQuantity > 10 ? "bg-soft-success text-success" : "bg-soft-danger text-danger") small">Stock: @product.StockQuantity.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Checkout Panel -->
    <div class="checkout-panel">
        <div class="card border-0 shadow-lg rounded-4 checkout-card h-100">
            <div class="card-header bg-dark text-white py-3 rounded-top-4 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fas fa-shopping-cart me-2"></i>Current Order</h5>
                    <span class="badge bg-primary rounded-pill" id="cartBadge">0 items</span>
                </div>
            </div>
            
            <div class="card-body d-flex flex-column p-0 overflow-hidden">
                <!-- Cart Items - This has its own scrollbar -->
                <div class="cart-items-container flex-grow-1 overflow-auto p-4" id="cartItems">
                    <div class="text-center py-5 text-muted empty-cart-msg">
                        <i class="fas fa-shopping-basket fa-3x mb-3 opacity-25"></i>
                        <p class="fw-bold">Your cart is empty</p>
                        <small>Select products from the left to begin</small>
                    </div>
                </div>

                <!-- Summary Section -->
                <div class="summary-section p-4 bg-light border-top">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold" id="subtotal">₱0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span class="small">Tax (VAT 12%)</span>
                        <span class="fw-bold small" id="tax">₱0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 mt-2">
                        <h4 class="fw-bold mb-0">Total Due</h4>
                        <h4 class="fw-bold text-primary mb-0" id="total">₱0.00</h4>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Customer (Optional)</label>
                        <select id="customerId" class="form-select border-0 bg-white shadow-sm py-2">
                            <option value="">-- Guest Customer --</option>
                            @if (ViewBag.Customers != null)
                            {
                                foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.Id">@customer.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Payment Method</label>
                        <div class="d-flex gap-2">
                            <select id="paymentMethod" class="form-select border-0 bg-white shadow-sm py-2">
                                <option value="Cash">Cash Payment</option>
                                <option value="G-Cash">G-Cash Payment</option>
                            </select>
                        </div>
                    </div>

                    <div id="cashPaymentSection" class="payment-detail-card mb-3 p-3 bg-white rounded-3 shadow-sm border border-primary border-opacity-10">
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-primary">Amount Received</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-0 fw-bold">₱</span>
                                <input type="number" id="amountReceived" class="form-control border-0 fw-bold h5 mb-0 py-2" placeholder="0.00" step="0.01">
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted fw-bold">CHANGE DUE:</span>
                            <span class="h5 mb-0 fw-bold text-success" id="changeDue">₱0.00</span>
                        </div>
                    </div>

                    @if (Context.Session.GetInt32("UserRole") != 11)
                    {
                        <button class="btn btn-primary btn-lg w-100 rounded-pill mb-2 py-3 fw-bold shadow-sm" id="completeSale">
                            <i class="fas fa-check-circle me-2"></i>COMPLETE TRANSACTION
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-info small rounded-pill text-center mb-2">
                            <i class="fas fa-info-circle me-1"></i> Read-Only Console
                        </div>
                    }
                    <button class="btn btn-link text-muted w-100 btn-sm text-decoration-none" id="clearCart">
                        <i class="fas fa-redo me-1"></i> Clear Selection
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body p-5">
                <div id="receiptContent">
                    <div class="text-center mb-4">
                        <div class="h3 fw-bold mb-0 text-primary">CRUSTFLOW ERP</div>
                        <p class="text-muted small mb-0">Quality Bakes & Pastries</p>
                        <hr class="my-3 font-monospace">
                    </div>
                    
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">No:</span>
                        <span class="fw-bold" id="receiptId">#0000</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Cashier:</span>
                        <span class="fw-bold" id="receiptCashier">@ViewBag.CashierName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Cust:</span>
                        <span class="fw-bold text-truncate" style="max-width: 150px;" id="receiptCustomer">GUEST</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Date:</span>
                        <span id="receiptDate">--/--/----</span>
                    </div>

                    <div class="mb-4">
                        <table class="table table-sm table-borderless mb-0 small">
                            <thead>
                                <tr class="border-bottom text-muted">
                                    <th>ITEM</th>
                                    <th class="text-center">QTY</th>
                                    <th class="text-end">TOTAL</th>
                                </tr>
                            </thead>
                            <tbody id="receiptItems">
                                <!-- Populated via JS -->
                            </tbody>
                        </table>
                    </div>

                    <div class="border-top pt-3 mb-4">
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>SUBTOTAL</span>
                            <span id="receiptSubtotal">₱0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>VAT (12%)</span>
                            <span id="receiptTax">₱0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 fw-bold h4 mt-2">
                            <span>TOTAL</span>
                            <span id="receiptTotal" class="text-primary">₱0.00</span>
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 small border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">PAYMENT:</span>
                            <span class="fw-bold" id="receiptPayment">--</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">AMOUNT RECEIVED:</span>
                            <span class="fw-bold text-dark" id="receiptReceived">₱0.00</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-success border-top pt-2 mt-2 h5 mb-0">
                            <span>CHANGE:</span>
                            <span id="receiptChange">₱0.00</span>
                        </div>
                    </div>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="small text-muted mb-0">Thank you for your purchase!</p>
                        <p class="small text-muted mb-0">Please come again.</p>
                    </div>
                </div>

                <div class="mt-4 d-grid gap-2 no-print">
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-primary w-100 py-2 rounded-pill fw-bold shadow-sm" onclick="window.print()">
                                <i class="fas fa-print me-1"></i>PRINT
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" id="downloadPdfBtn" class="btn btn-outline-primary w-100 py-2 rounded-pill fw-bold">
                                <i class="fas fa-file-pdf me-1"></i>PDF
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-light py-2 rounded-pill fw-bold text-muted" onclick="location.reload()">
                        DONE & NEW SALE
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Reset main container padding for true full-height feel */
    main.p-3.p-lg-4 { padding: 0 !important; }
    
    /* Force the parent wrappers to not scroll */
    .cashier-content { height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
    main { flex: 1; overflow: hidden; }
    
    .pos-layout {
        display: flex;
        gap: 0;
        height: 100%;
        width: 100%;
        background: #f8f9fa;
    }

    .products-panel {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
    }

    .checkout-panel {
        width: 420px;
        flex-shrink: 0;
        height: 100%;
        padding: 1.5rem;
        background: white;
        border-left: 1px solid rgba(0,0,0,0.05);
        box-shadow: -10px 0 30px rgba(0,0,0,0.02);
    }

    /* Custom Scrollbar */
    .products-panel::-webkit-scrollbar,
    .cart-items-container::-webkit-scrollbar {
        width: 6px;
    }

    .products-panel::-webkit-scrollbar-thumb,
    .cart-items-container::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }

    .product-card { 
        cursor: pointer; 
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05)!important;
        background: white;
    }
    
    .product-card:hover { 
        transform: translateY(-8px); 
        box-shadow: 0 1rem 2rem rgba(0,0,0,0.12)!important; 
        border-color: var(--bs-primary)!important;
    }

    .product-card:hover .product-image-wrapper img {
        transform: scale(1.1);
    }

    .bg-soft-success { background-color: #d1e7dd; color: #0f5132; }
    .bg-soft-danger { background-color: #f8d7da; color: #842029; }

    .checkout-card {
        border-radius: 20px !important;
        border: none !important;
        height: 100%;
    }

    .cart-items-container {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem !important;
    }

    .summary-section {
        background: #f8f9fa !important;
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
        padding: 1.5rem !important;
    }

    .payment-detail-card {
        background: #fff !important;
        border: 1px solid rgba(0,0,0,0.08) !important;
    }

    .qty-btn { 
        width: 28px; 
        height: 28px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        border-radius: 8px; 
        cursor: pointer; 
        border: none;
        background: #e9ecef;
        transition: all 0.2s;
    }
    
    .qty-btn:hover {
        background: var(--bs-primary);
        color: white;
    }

    /* Hide the default shared footer for a true full-screen POS experience */
    footer { display: none !important; }

    @@media (max-width: 1200px) {
        .pos-layout { flex-direction: column; height: auto; overflow: visible; }
        .checkout-panel { width: 100%; height: auto; border-left: none; border-top: 1px solid #eee; }
        main.p-3.p-lg-4 { padding: 1rem !important; }
    }

    #receiptContent {
        line-height: 1.2;
        font-family: 'Courier New', Courier, monospace;
    }
    #receiptContent hr {
        border-top: 1px dashed #000;
        opacity: 0.5;
    }
    #receiptContent .table td, #receiptContent .table th {
        padding: 2px 0;
    }
    
    @@media print {
        body * { visibility: hidden; }
        #receiptModal, #receiptModal * { visibility: visible; }
        #receiptModal { position: absolute; left: 0; top: 0; width: 100%; border: 0 !important; }
        .no-print { display: none !important; }
    }
</style>

<script>
    let cart = [];

    function addToCart(id, name, price, stock) {
        const existing = cart.find(i => i.id === id);
        if (existing) {
            if (existing.quantity >= stock) {
                alert("Insufficient stock!");
                return;
            }
            existing.quantity++;
        } else {
            if (stock <= 0) {
                alert("Out of stock!");
                return;
            }
            cart.push({ id, name, price, quantity: 1, stock });
        }
        renderCart();
    }

    function removeFromCart(id) {
        cart = cart.filter(i => i.id !== id);
        renderCart();
    }

    function updateQty(id, delta) {
        const item = cart.find(i => i.id === id);
        if (item) {
            item.quantity += delta;
            if (item.quantity > item.stock) {
                item.quantity = item.stock;
                alert("Insufficient stock!");
            }
            if (item.quantity <= 0) removeFromCart(id);
            else renderCart();
        }
    }

    function renderCart() {
        const container = document.getElementById('cartItems');
        const badge = document.getElementById('cartBadge');
        
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        badge.innerText = `${totalItems} ${totalItems === 1 ? 'item' : 'items'}`;

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="text-center py-5 text-muted empty-cart-msg">
                    <i class="fas fa-shopping-basket fa-3x mb-3 opacity-25"></i>
                    <p class="fw-bold">Your cart is empty</p>
                    <small>Select products from the left to begin</small>
                </div>`;
            updateTotals(0);
            return;
        }

        let html = '';
        let subtotal = 0;
        cart.forEach(item => {
            const lineTotal = item.price * item.quantity;
            subtotal += lineTotal;
            html += `
                <div class="cart-item d-flex justify-content-between align-items-center animate__animated animate__fadeInRight">
                    <div class="flex-grow-1">
                        <div class="fw-bold text-truncate" style="max-width: 140px;">${item.name}</div>
                        <div class="small text-muted">₱${item.price.toFixed(2)}</div>
                    </div>
                    <div class="d-flex align-items-center gap-2 px-3">
                        <button class="qty-btn" onclick="updateQty(${item.id}, -1)"><i class="fas fa-minus small"></i></button>
                        <span class="fw-bold" style="min-width: 20px; text-align: center;">${item.quantity}</span>
                        <button class="qty-btn" onclick="updateQty(${item.id}, 1)"><i class="fas fa-plus small"></i></button>
                    </div>
                    <div class="text-end" style="min-width: 80px;">
                        <div class="fw-bold">₱${lineTotal.toFixed(2)}</div>
                        <i class="fas fa-times-circle text-danger small cursor-pointer opacity-50 hover-opacity-100" onclick="removeFromCart(${item.id})"></i>
                    </div>
                </div>`;
        });
        container.innerHTML = html;
        updateTotals(subtotal);
    }

    function updateTotals(subtotal) {
        const tax = subtotal * 0.12;
        const total = subtotal + tax;
        document.getElementById('subtotal').innerText = `₱${subtotal.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        document.getElementById('tax').innerText = `₱${tax.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        document.getElementById('total').innerText = `₱${total.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        
        const btn = document.getElementById('completeSale');
        if (btn) btn.disabled = (total <= 0);
        
        calculateChange();
    }

    function calculateChange() {
        const totalStr = document.getElementById('total').innerText.replace('₱', '').replace(/,/g, '');
        const total = parseFloat(totalStr);
        const received = parseFloat(document.getElementById('amountReceived').value) || 0;
        const change = received - total;
        
        const changeEl = document.getElementById('changeDue');
        changeEl.innerText = `₱${(change > 0 ? change : 0).toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        
        if (received < total && received > 0) {
            changeEl.classList.replace('text-success', 'text-danger');
        } else {
            changeEl.classList.replace('text-danger', 'text-success');
        }
    }

    document.getElementById('amountReceived').addEventListener('input', calculateChange);

    document.getElementById('paymentMethod').addEventListener('change', function(e) {
        const section = document.getElementById('cashPaymentSection');
        if (e.target.value === 'Cash') {
            section.style.display = 'block';
        } else {
            section.style.display = 'none';
        }
    });

    // Search Logic
    document.getElementById('productSearch').addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.product-item').forEach(item => {
            const name = item.getAttribute('data-name');
            item.style.display = name.includes(term) ? 'block' : 'none';
        });
    });

    document.getElementById('clearCart').onclick = () => {
        cart = [];
        document.getElementById('amountReceived').value = '';
        renderCart();
    };

    document.getElementById('completeSale').onclick = async () => {
        if (cart.length === 0) return;
        
        const totalStr = document.getElementById('total').innerText.replace('₱', '').replace(/,/g, '');
        const total = parseFloat(totalStr);
        const paymentMethod = document.getElementById('paymentMethod').value;
        const customerId = document.getElementById('customerId').value || null;
        const received = parseFloat(document.getElementById('amountReceived').value) || 0;

        if (paymentMethod === 'Cash' && received < total) {
            alert("Insufficient payment amount!");
            return;
        }
        
        const saleData = {
            TotalAmount: total,
            PaymentMethod: paymentMethod,
            CustomerId: customerId,
            SaleDetails: cart.map(i => ({
                ProductId: i.id,
                Quantity: i.quantity,
                UnitPrice: i.price,
                Subtotal: i.price * i.quantity
            }))
        };

        try {
            const btn = document.getElementById('completeSale');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            const response = await fetch('/Cashier/SubmitSale', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(saleData)
            });

            const result = await response.json();
            if (result.success) {
                showReceipt(result.saleId, saleData, received);
            } else {
                alert("Error: " + result.message);
                btn.disabled = false;
                btn.innerText = 'COMPLETE TRANSACTION';
            }
        } catch (error) {
            console.error(error);
            alert("An error occurred while processing the sale.");
            document.getElementById('completeSale').disabled = false;
        }
    };

    document.getElementById('productSearch').addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.product-item').forEach(item => {
            const name = item.getAttribute('data-name');
            item.style.display = name.includes(term) ? 'block' : 'none';
        });
    });


    function showReceipt(id, saleData, received) {
        document.getElementById('receiptId').innerText = `#SALE-${id.toString().padStart(4, '0')}`;
        document.getElementById('receiptDate').innerText = new Date().toLocaleString();
        
        const customerSelect = document.getElementById('customerId');
        document.getElementById('receiptCustomer').innerText = customerSelect.options[customerSelect.selectedIndex].text;
        
        document.getElementById('receiptPayment').innerText = saleData.PaymentMethod;
        
        const subtotal = saleData.TotalAmount / 1.12;
        const tax = saleData.TotalAmount - subtotal;
        
        document.getElementById('receiptSubtotal').innerText = `₱${subtotal.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        document.getElementById('receiptTax').innerText = `₱${tax.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        document.getElementById('receiptTotal').innerText = `₱${saleData.TotalAmount.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        
        document.getElementById('receiptReceived').innerText = `₱${received.toLocaleString('en-PH', {minimumFractionDigits: 2})}`;
        const change = received - saleData.TotalAmount;
        document.getElementById('receiptChange').innerText = `₱${(change > 0 ? change : 0).toLocaleString('en-PH', {minimumFractionDigits: 2})}`;

        let rows = '';
        cart.forEach(item => {
            rows += `
                <tr>
                    <td>${item.name}</td>
                    <td class="text-center">${item.quantity}</td>
                    <td class="text-end">₱${(item.price * item.quantity).toFixed(2)}</td>
                </tr>`;
        });
        document.getElementById('receiptItems').innerHTML = rows;

        // Set up PDF download button
        document.getElementById('downloadPdfBtn').onclick = () => {
            window.location.href = `/Cashier/DownloadReceipt?saleId=${id}`;
        };

        const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
        modal.show();
    }

</script>
