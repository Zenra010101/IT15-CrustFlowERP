@model IEnumerable<CrustFlowERP.Models.Production.Product>
@{
    ViewData["Title"] = "Available Stock";
    
    var totalItems = Model?.Count() ?? 0;
    var lowStockItems = Model?.Count(p => p.StockQuantity <= p.MinStockLevel) ?? 0;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-6"><i class="fas fa-boxes me-2 text-primary"></i>Available Stock</h2>
            <p class="text-muted">Check current inventory levels for all products.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-3 text-center p-3 h-100">
                <div class="display-6 text-primary mb-2">@totalItems</div>
                <div class="text-muted small text-uppercase">Total Items</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-3 text-center p-3 h-100">
                <div class="display-6 text-warning mb-2">@lowStockItems</div>
                <div class="text-muted small text-uppercase">Low Stock</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 mt-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                var isLow = product.StockQuantity <= product.MinStockLevel;
                                <tr>
                                    <td class="fw-bold">@product.Name</td>
                                    <td><span class="badge bg-light text-dark border">@product.Category</span></td>
                                    <td>@product.StockQuantity.ToString("N0")</td>
                                    <td>
                                        @if (isLow)
                                        {
                                            <span class="badge bg-danger">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No products available in inventory.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
