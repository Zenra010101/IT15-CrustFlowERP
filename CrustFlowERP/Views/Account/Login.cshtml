@model CrustFlowERP.Models.LoginViewModel
@{
    ViewData["Title"] = "Login - CrustFlowERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #f5e6d3 0%, #e8d4b0 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(139, 90, 43, 0.15);
            overflow: hidden;
            max-width: 450px;
            width: 100%;
        }
        
        @@media (max-width: 576px) {
            .login-container {
                padding: 10px;
            }
            
            .login-card {
                max-width: 100%;
                border-radius: 15px;
                margin: 0 10px;
            }
        }
        
        @@media (max-width: 400px) {
            .login-container {
                padding: 5px;
            }
            
            .login-card {
                border-radius: 10px;
                margin: 0 5px;
            }
        }
        
        .login-header {
            background: linear-gradient(135deg, #8b5a2b 0%, #a0522d 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        @@media (max-width: 576px) {
            .login-header {
                padding: 20px;
            }
        }
        
        @@media (max-width: 400px) {
            .login-header {
                padding: 15px;
            }
        }
        
        .login-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
        }
        
        @@media (max-width: 768px) {
            .login-header h1 {
                font-size: 1.5rem;
            }
        }
        
        @@media (max-width: 576px) {
            .login-header h1 {
                font-size: 1.2rem;
            }
        }
        
        .login-header .subtitle {
            margin-top: 10px;
            opacity: 0.9;
            font-size: 0.9rem;
        }
        
        @@media (max-width: 768px) {
            .login-header .subtitle {
                font-size: 0.8rem;
                margin-top: 8px;
            }
        }
        
        @@media (max-width: 576px) {
            .login-header .subtitle {
                font-size: 0.7rem;
                margin-top: 5px;
            }
        }
        
        .login-body {
            padding: 40px 30px;
        }
        
        @@media (max-width: 768px) {
            .login-body {
                padding: 20px 15px;
            }
        }
        
        @@media (max-width: 576px) {
            .login-body {
                padding: 15px 10px;
            }
        }
        
        @@media (max-width: 400px) {
            .login-body {
                padding: 10px 5px;
            }
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        @@media (max-width: 768px) {
            .form-group {
                margin-bottom: 20px;
            }
        }
        
        @@media (max-width: 576px) {
            .form-group {
                margin-bottom: 15px;
            }
        }
        
        .form-label {
            font-weight: 600;
            color: #8b5a2b;
            margin-bottom: 8px;
        }
        
        .form-control {
            border: 2px solid #e8d4b0;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        @@media (max-width: 768px) {
            .form-control {
                padding: 10px 12px;
                font-size: 0.9rem;
            }
        }
        
        @@media (max-width: 400px) {
            .form-control {
                padding: 8px 10px;
                font-size: 0.85rem;
                border-radius: 8px;
            }
        }
        
        .form-control:focus {
            border-color: #a0522d;
            box-shadow: 0 0 0 0.2rem rgba(160, 82, 45, 0.25);
        }
        
        .btn-login {
            background: linear-gradient(135deg, #8b5a2b 0%, #a0522d 100%);
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            padding: 12px;
            font-size: 1rem;
            width: 100%;
            transition: all 0.3s ease;
        }
        
        @@media (max-width: 768px) {
            .btn-login {
                padding: 10px;
                font-size: 0.9rem;
                border-radius: 8px;
            }
        }
        
        @@media (max-width: 400px) {
            .btn-login {
                padding: 8px;
                font-size: 0.85rem;
                border-radius: 6px;
            }
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(139, 90, 43, 0.3);
        }
        
        .btn-login:active {
            transform: translateY(0);
        }
        
        .form-check-input:checked {
            background-color: #8b5a2b;
            border-color: #8b5a2b;
        }
        
        .alert {
            border-radius: 10px;
            border: none;
        }
        
        .logo-icon {
            font-size: 3rem;
            margin-bottom: 20px;
        }
        
        @@media (max-width: 768px) {
            .logo-icon {
                font-size: 2.5rem;
                margin-bottom: 15px;
            }
        }
        
        @@media (max-width: 400px) {
            .logo-icon {
                font-size: 2rem;
                margin-bottom: 10px;
            }
        }
        
        .footer-text {
            text-align: center;
            margin-top: 30px;
            color: #8b5a2b;
            font-size: 0.9rem;
        }
        
        @@media (max-width: 768px) {
            .footer-text {
                margin-top: 20px;
                font-size: 0.8rem;
            }
        }
        
        @@media (max-width: 400px) {
            .footer-text {
                margin-top: 15px;
                font-size: 0.7rem;
            }
        }
        
        .validation-summary-errors {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-container">
                    <img src="~/images/crustflow-logo.png" alt="CrustFlow Logo" style="max-width: 120px; height: auto; margin-bottom: 15px;" />
                </div>
                <h1>CrustFlowERP</h1>
                <div class="subtitle">ERP System for Production and Manufacturing</div>               
            </div>
            
            <div class="login-body">
                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                    
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="john.doe@crustflow.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <button type="submit" class="btn btn-login">Sign In</button>
                    </div>
                </form>
                
                <div class="footer-text">
                    <p>&copy; 2026 CrustFlowERP. All rights reserved.</p>
                </div>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
