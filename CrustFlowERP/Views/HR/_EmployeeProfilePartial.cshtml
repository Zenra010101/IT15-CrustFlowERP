@model CrustFlowERP.Models.HR.Employee

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold">Employee Profile</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body p-4">
    <div class="text-center mb-4">
        <div class="avatar-lg bg-soft-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px;">
            <span class="fs-1 fw-bold text-primary">@Model.FirstName[0]@Model.LastName[0]</span>
        </div>
        <h4 class="fw-bold mb-1">@Model.FullName</h4>
        <p class="badge bg-soft-primary text-primary rounded-pill px-3 py-2">@Model.EmployeeCode</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-4">
                <small class="text-muted d-block mb-1">Position & Department</small>
                <div class="fw-bold">@Model.Position</div>
                <div class="small text-secondary">@Model.Department</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-4 position-relative">
                <small class="text-muted d-block mb-1">Base Salary</small>
                <div class="d-flex align-items-center justify-content-between">
                    <div id="salaryDisplay" class="fw-bold text-success fs-5">₱@Model.BaseSalary.ToString("N2")</div>
                    @if (Context.Session.GetInt32("UserRole") != 11)
                    {
                        <button class="btn btn-sm btn-soft-primary rounded-circle" onclick="toggleSalaryEdit()" id="editSalaryBtn">
                            <i class="fas fa-edit"></i>
                        </button>
                    }
                </div>
                
                <div id="salaryEditForm" style="display: none;">
                    <div class="input-group input-group-sm mt-1">
                        <span class="input-group-text bg-white border-0">₱</span>
                        <input type="number" id="newSalaryInput" class="form-control border-0 bg-white" value="@Model.BaseSalary" step="0.01">
                        <button class="btn btn-primary" onclick="saveSalary(@Model.Id)">
                            <i class="fas fa-check"></i>
                        </button>
                        <button class="btn btn-light" onclick="toggleSalaryEdit()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <div class="small text-secondary mt-1">Joined: @Model.DateJoined.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded-4">
                <small class="text-muted d-block mb-1">Contact Information</small>
                <div class="small fw-bold">@Model.Email</div>
                <div class="small">@Model.ContactNumber</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-4">
                <small class="text-muted d-block mb-1">Address</small>
                <div class="small">@(Model.Address ?? "No address recorded")</div>
            </div>
        </div>
        <div class="col-12">
            <div class="p-3 border rounded-4 bg-white shadow-sm">
                <h6 class="fw-bold mb-3"><i class="fas fa- lifeboat me-2 text-danger"></i>Emergency Contact</h6>
                <div class="row">
                    <div class="col-6">
                        <small class="text-muted d-block">Contact Name</small>
                        <div class="fw-bold">@(Model.EmergencyContact ?? "N/A")</div>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Phone Number</small>
                        <div class="fw-bold">@(Model.EmergencyPhone ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer border-top-0">
    <button type="button" class="btn btn-primary px-4 rounded-pill" data-bs-dismiss="modal">Close Profile</button>
</div>

<style>
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.1); }
    .btn-soft-primary { 
        background-color: rgba(13, 110, 253, 0.1); 
        color: #0d6efd; 
        border: none;
    }
    .btn-soft-primary:hover {
        background-color: #0d6efd;
        color: white;
    }
</style>
