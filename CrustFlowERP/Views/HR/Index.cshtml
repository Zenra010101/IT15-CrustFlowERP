@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4 animate__animated animate__fadeIn">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">Human Resources Dashboard</h2>
            <p class="text-muted small">Overview of workforce stats, attendance, and payroll status.</p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4 animate__animated animate__fadeIn">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="stats-icon bg-soft-primary rounded-pill p-3 me-3 text-primary">
                        <i class="fas fa-users fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold">Total Staff</p>
                        <h3 class="fw-bold mb-0">@ViewBag.EmployeesCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="stats-icon bg-soft-success rounded-pill p-3 me-3 text-success">
                        <i class="fas fa-user-check fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold">On-Duty Today</p>
                        <h3 class="fw-bold mb-0">@ViewBag.AttendanceToday</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="stats-icon bg-soft-warning rounded-pill p-3 me-3 text-warning">
                        <i class="fas fa-file-invoice-dollar fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold">Pending Payrolls</p>
                        <h3 class="fw-bold mb-0">@ViewBag.PayrollsCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="stats-icon bg-soft-danger rounded-pill p-3 me-3 text-danger">
                        <i class="fas fa-clock fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold">Late Records Today</p>
                        <h3 class="fw-bold mb-0">@ViewBag.LateRecords</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation -->
    <div class="row g-4 animate__animated animate__fadeIn">
        <div class="col-lg-4">
            <a asp-action="Employees" class="text-decoration-none h-100 d-block">
                <div class="card border-0 shadow-sm rounded-4 transition-hover h-100 bg-white p-4">
                    <div class="text-primary mb-3">
                        <i class="fas fa-id-card-clip fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Employee Profiles</h5>
                    <p class="text-muted small mb-0">Manage employee personal data, positions, and history.</p>
                </div>
            </a>
        </div>
        <div class="col-lg-4">
            <a asp-action="Attendance" class="text-decoration-none h-100 d-block">
                <div class="card border-0 shadow-sm rounded-4 transition-hover h-100 bg-white p-4">
                    <div class="text-success mb-3">
                        <i class="fas fa-calendar-check fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Time & Attendance</h5>
                    <p class="text-muted small mb-0">Daily clock-in logs, late tracking, and leave management.</p>
                </div>
            </a>
        </div>
        <div class="col-lg-4">
            <a asp-action="Payroll" class="text-decoration-none h-100 d-block">
                <div class="card border-0 shadow-sm rounded-4 transition-hover h-100 bg-white p-4">
                    <div class="text-warning mb-3">
                        <i class="fas fa-money-check-dollar fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Payroll Center</h5>
                    <p class="text-muted small mb-0">Process monthly salaries, deductions, and payment slips.</p>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary { background: rgba(13, 110, 253, 0.1); }
    .bg-soft-success { background: rgba(25, 135, 84, 0.1); }
    .bg-soft-warning { background: rgba(255, 193, 7, 0.1); }
    .bg-soft-danger { background: rgba(220, 53, 69, 0.1); }
    .transition-hover:hover { transform: translateY(-5px); transition: transform 0.3s ease; box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; }
</style>
