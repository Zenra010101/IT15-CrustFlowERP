@model IEnumerable<CrustFlowERP.Models.HR.Payroll>
@{
    ViewData["Title"] = "Payroll";
    var employees = ViewBag.Employees as IEnumerable<CrustFlowERP.Models.HR.Employee>;
}

<div class="container-fluid py-4">
    <div class="row mb-4 animate__animated animate__fadeIn">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1">Payroll Management</h2>
                <p class="text-muted small">Process salaries, generate pay slips, and track payments.</p>
            </div>
            @if (Context.Session.GetInt32("UserRole") != 11)
            {
                <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#generatePayrollModal">
                    <i class="fas fa-file-invoice-dollar me-2"></i>Run Payroll
                </button>
            }
        </div>
    </div>

    <div class="row g-4 animate__animated animate__fadeIn">
        <div class="col-md-9">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 py-4 px-4">
                    <h5 class="fw-bold mb-0 text-primary">Recent Payroll Runs</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="border-top-0">
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Employee</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Period</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Net Pay</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Status</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-soft-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="text-success fw-bold">@(p.Employee?.FirstName?[0] ?? 'E')@(p.Employee?.LastName?[0] ?? 'P')</span>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@(p.Employee?.FullName ?? "N/A")</h6>
                                                <small class="text-muted">@(p.Employee?.EmployeeCode ?? "N/A")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 border-bottom-0">
                                        <p class="mb-0 small fw-bold">@p.PayPeriodStart.ToShortDateString() - @p.PayPeriodEnd.ToShortDateString()</p>
                                    </td>
                                    <td class="px-4 py-3 border-bottom-0 fw-bold text-dark">PHP @p.NetPay.ToString("N2")</td>
                                    <td class="px-4 py-3 border-bottom-0">
                                        <span class="badge @(p.Status == "Paid" ? "bg-success" : "bg-warning") bg-opacity-10 @(p.Status == "Paid" ? "text-success" : "text-warning") px-3 py-2 rounded-pill">@p.Status</span>
                                    </td>
                                    <td class="px-4 py-3 border-bottom-0">
                                        <button class="btn btn-light btn-sm rounded-circle"><i class="fas fa-eye"></i></button>
                                        <button class="btn btn-light btn-sm rounded-circle ms-1"><i class="fas fa-print"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="avatar-md bg-white bg-opacity-20 rounded-pill d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <i class="fas fa-money-check-alt fs-5"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-2">This Month</span>
                    </div>
                    <h6>Total Payout</h6>
                    <h3 class="fw-bold">PHP @Model.Where(p => p.Status == "Paid").Sum(p => p.NetPay).ToString("N2")</h3>
                    <p class="small mb-0 opacity-75">Processed for @Model.Count() employees</p>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Upcoming Payments</h6>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 border-0 mb-2">
                            <p class="mb-1 small text-muted">Next Pay Date</p>
                            <h6 class="fw-bold mb-0">March 31, 2026</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for generating payroll -->
<div class="modal fade" id="generatePayrollModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Process New Payroll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="generatePayrollForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Employee</label>
                        <select class="form-select rounded-3 p-3 bg-light border-0" name="EmployeeId" id="payrollEmpSelect" required>
                            <option value="">-- Choose Employee --</option>
                            @if (ViewBag.Employees != null) {
                                @foreach (var emp in (List<CrustFlowERP.Models.HR.Employee>)ViewBag.Employees)
                                {
                                    <option value="@emp.Id" data-salary="@emp.BaseSalary">@emp.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Period Start</label>
                            <input type="date" class="form-control rounded-3" name="PayPeriodStart" required value="@DateTime.Now.AddDays(-15).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Period End</label>
                            <input type="date" class="form-control rounded-3" name="PayPeriodEnd" required value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Base Pay</label>
                            <input type="number" step="0.01" class="form-control rounded-3" name="BasePay" id="payrollBasePay" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Overtime Pay</label>
                            <input type="number" step="0.01" class="form-control rounded-3" name="OvertimePay" value="0.00">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Deductions</label>
                        <input type="number" step="0.01" class="form-control rounded-3" name="Deductions" value="0.00">
                    </div>
                </div>
                <div class="modal-footer border-top-0 p-4">
                    <button type="button" class="btn btn-light px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill">Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('payrollEmpSelect').addEventListener('change', function() {
            const salary = this.options[this.selectedIndex]?.dataset.salary;
            if (salary) {
                document.getElementById('payrollBasePay').value = salary;
            }
        });

        document.getElementById('generatePayrollForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            data.Status = "Paid";
            data.PaymentDate = new Date().toISOString();
            
            fetch('/HR/GeneratePayroll', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        });
    </script>
}

<style>
    .bg-soft-success { background: rgba(25, 135, 84, 0.1); }
</style>
