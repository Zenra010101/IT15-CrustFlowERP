@model IEnumerable<CrustFlowERP.Models.HR.Attendance>
@{
    ViewData["Title"] = "Attendance";
    var employees = ViewBag.Employees as IEnumerable<CrustFlowERP.Models.HR.Employee>;
}

<div class="container-fluid py-4">
    <div class="row mb-4 animate__animated animate__fadeIn">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1">Time & Attendance</h2>
                <p class="text-muted small">Tracking staff attendance, log checks, and status.</p>
            </div>
            @if (Context.Session.GetInt32("UserRole") != 11)
            {
                <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#logAttendanceModal">
                    <i class="fas fa-clock me-2"></i>Log Attendance
                </button>
            }
        </div>
    </div>

    <div class="row animate__animated animate__fadeIn">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 py-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">Attendance Records</h5>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control rounded-pill border-0 bg-light" placeholder="Search employee..." style="width: 250px;">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="border-top-0">
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Employee</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Date</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase" colspan="2">Morning Session</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase" colspan="2">Afternoon Session</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Status</th>
                                <th class="px-4 py-3 text-secondary small fw-bold text-uppercase">Duration</th>
                            </tr>
                            <tr class="bg-light-subtle">
                                <th class="border-0"></th>
                                <th class="border-0"></th>
                                <th class="px-4 py-1 text-muted smaller">In</th>
                                <th class="px-4 py-1 text-muted smaller">Out</th>
                                <th class="px-4 py-1 text-muted smaller">In</th>
                                <th class="px-4 py-1 text-muted smaller">Out</th>
                                <th class="border-0"></th>
                                <th class="border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var att in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-soft-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="text-primary fw-bold">@(att.Employee?.FirstName?[0] ?? 'E')@(att.Employee?.LastName?[0] ?? 'P')</span>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@(att.Employee?.FullName ?? "N/A")</h6>
                                                <small class="text-muted">@(att.Employee?.EmployeeCode ?? "N/A")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 border-bottom-0 text-muted small">@att.Date.ToString("MMM dd, yyyy")</td>
                                    
                                    <!-- Morning In -->
                                    <td class="px-4 py-3 border-bottom-0">
                                        @if (att.CheckInMorning.HasValue) {
                                            <span class="text-dark small">@att.CheckInMorning.Value.ToString("hh:mm tt")</span>
                                        } else { <span class="text-muted opacity-25">-</span> }
                                    </td>
                                    
                                    <!-- Morning Out -->
                                    <td class="px-4 py-3 border-bottom-0">
                                        @if (att.CheckOutMorning.HasValue) {
                                            <span class="text-dark small">@att.CheckOutMorning.Value.ToString("hh:mm tt")</span>
                                        } else { <span class="text-muted opacity-25">-</span> }
                                    </td>

                                    <!-- Afternoon In -->
                                    <td class="px-4 py-3 border-bottom-0">
                                        @if (att.CheckInAfternoon.HasValue) {
                                            <span class="text-dark small">@att.CheckInAfternoon.Value.ToString("hh:mm tt")</span>
                                        } else { <span class="text-muted opacity-25">-</span> }
                                    </td>
                                    
                                    <!-- Afternoon Out -->
                                    <td class="px-4 py-3 border-bottom-0">
                                        @if (att.CheckOutAfternoon.HasValue) {
                                            <span class="text-dark small">@att.CheckOutAfternoon.Value.ToString("hh:mm tt")</span>
                                        } else { <span class="text-muted opacity-25">-</span> }
                                    </td>

                                    <td class="px-4 py-3 border-bottom-0">
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Present</span>
                                    </td>
                                    <td class="px-4 py-3 border-bottom-0 text-muted small">
                                        <span>@att.DurationHours.ToString("F1") hrs</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for logging attendance -->
<div class="modal fade" id="logAttendanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Morning & Afternoon Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="logAttendanceForm">
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted mb-1 fs-4 fw-light" id="currentTime">--:-- --</p>
                        <p class="small text-primary fw-bold">@DateTime.Today.ToString("dddd, MMMM dd")</p>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label small fw-bold">1. Select Employee</label>
                        <select class="form-select rounded-3 p-3 bg-light border-0" name="EmployeeId" required>
                            <option value="">-- Choose Employee --</option>
                            @if (employees != null) {
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted mb-3">Which action would you like to perform?</label>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-attendance-in flex-fill py-4 rounded-4 shadow-sm border-0 position-relative overflow-hidden" onclick="submitLog('CheckIn')">
                                <i class="fas fa-sign-in-alt mb-2 d-block fs-2"></i>
                                <span class="fw-bold fs-5">Check In</span>
                            </button>
                            <button type="button" class="btn btn-attendance-out flex-fill py-4 rounded-4 shadow-sm border-0 position-relative overflow-hidden" onclick="submitLog('CheckOut')">
                                <i class="fas fa-sign-out-alt mb-2 d-block fs-2"></i>
                                <span class="fw-bold fs-5">Check Out</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 p-4">
                    <button type="button" class="btn btn-light px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update time
        function updateTime() {
            const timeEl = document.getElementById('currentTime');
            if (timeEl) {
                timeEl.innerText = new Date().toLocaleTimeString();
            }
        }
        setInterval(updateTime, 1000);
        updateTime();

        function submitLog(action) {
            const employeeId = document.querySelector('select[name="EmployeeId"]').value;
            if (!employeeId) {
                alert('Please select an employee first');
                return;
            }

            const data = {
                EmployeeId: parseInt(employeeId),
                Action: action
            };
            
            fetch('/HR/LogAttendance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
}

<style>
    .bg-soft-primary { background: rgba(13, 110, 253, 0.1); }
    .bg-soft-info { background: rgba(13, 202, 240, 0.1); }
    .smaller { font-size: 0.75rem; }
    
    .btn-attendance-in {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        transition: all 0.3s ease;
    }
    .btn-attendance-in:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4);
        color: white;
    }
    
    .btn-attendance-out {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        transition: all 0.3s ease;
    }
    .btn-attendance-out:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.4);
        color: white;
    }
</style>
