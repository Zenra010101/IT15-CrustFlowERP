@using CrustFlowERP.Models.Production
@{
    ViewData["Title"] = "QC Inspection Terminal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pendingOrders = (List<ProductionOrder>)ViewBag.PendingOrders;
    var recentChecks = (List<QualityCheck>)ViewBag.RecentChecks;
}

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pt-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quality Assurance Terminal</h2>
            <p class="text-muted"><i class="fas fa-check-double me-2"></i>Verify production standards and authorize batch release.</p>
        </div>
        <div>
            <div class="badge bg-light text-dark p-2 px-3 border border-secondary border-opacity-10 shadow-sm">
                <i class="fas fa-user-shield me-2 text-primary"></i>QC Officer: @ViewBag.UserEmail
            </div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white p-3 h-100">
                <small class="opacity-75 text-uppercase fw-bold">Pending Approval</small>
                <h2 class="fw-bold mb-0">@pendingOrders.Count</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white p-3 h-100">
                <small class="opacity-75 text-uppercase fw-bold">Passed (History)</small>
                <h2 class="fw-bold mb-0">@recentChecks.Count(c => c.IsPassed)</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white p-3 h-100">
                <small class="opacity-75 text-uppercase fw-bold">Failed (History)</small>
                <h2 class="fw-bold mb-0">@recentChecks.Count(c => !c.IsPassed)</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 h-100">
                <small class="text-muted text-uppercase fw-bold">Total Inspections</small>
                <h2 class="fw-bold mb-0">@recentChecks.Count</h2>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Panel: Pending Inspections -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0 text-primary"><i class="fas fa-hourglass-half me-2"></i>Batches Awaiting Inspection</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Batch ID</th>
                                <th>Product</th>
                                <th class="text-center">Actual Qty</th>
                                <th>Competed At</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pendingOrders.Any())
                            {
                                foreach (var order in pendingOrders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">#PROD-@order.Id.ToString("D4")</td>
                                        <td>
                                            <div class="fw-bold">@order.Product?.Name</div>
                                            <small class="text-muted">@order.Product?.Category</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border p-2">@order.QuantityActual.ToString("N0")</span>
                                        </td>
                                        <td>@order.ActualEnd?.ToString("MMM dd, hh:mm tt")</td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" 
                                                    onclick="openInspectionModal('@order.Id', '@order.Product?.Name', '@order.QuantityActual')">
                                                <i class="fas fa-microscope me-1"></i> Inspect
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="py-5 text-center text-muted">
                                        <i class="fas fa-check-circle fa-3x mb-3 opacity-25"></i>
                                        <p class="mb-0">Excellent! No batches are currently pending inspection.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Panel: History -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-history me-2"></i>Recent Log</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (recentChecks.Any())
                        {
                            foreach (var check in recentChecks)
                            {
                                <li class="list-group-item p-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-bold">#PROD-@check.ProductionOrder?.Id.ToString("D4")</span>
                                        @if (check.IsPassed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-2">PASSED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 rounded-pill px-2">FAILED</span>
                                        }
                                    </div>
                                    <div class="small text-muted mb-2">@check.ProductionOrder?.Product?.Name</div>
                                    <div class="small p-2 bg-light rounded italic text-dark opacity-75 mb-2">
                                        "@check.Remarks"
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small">
                                        <span class="text-muted"><i class="far fa-clock me-1"></i>@check.CheckedAt.ToString("MM/dd HH:mm")</span>
                                        <span class="text-primary font-monospace">@check.CheckedBy.Split('@')[0]</span>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="p-4 text-center text-muted">No inspection history yet.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Inspection Modal -->
<div class="modal fade" id="inspectionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="LogInpsection" method="post" class="modal-content border-0 shadow-lg rounded-4">
            <input type="hidden" name="orderId" id="modalOrderId" />
            <div class="modal-header border-0 bg-primary text-white p-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-clipboard-list me-2"></i>Batch Inspection Report</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4 text-center p-3 bg-light rounded-3">
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Inspecting Product</h6>
                    <h4 class="fw-bold text-dark mb-0" id="modalProductName">---</h4>
                    <span class="text-primary small" id="modalBatchId">#PROD-0000</span>
                </div>

                <div class="mb-4">
                    <label class="form-label d-block fw-bold text-dark">Inspection Outcome</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="isPassed" id="pass" value="true" checked>
                        <label class="btn btn-outline-success py-3" for="pass">
                            <i class="fas fa-check-circle fa-2x d-block mb-1"></i>
                            PASSED
                        </label>
                        <input type="radio" class="btn-check" name="isPassed" id="fail" value="false">
                        <label class="btn btn-outline-danger py-3" for="fail">
                            <i class="fas fa-times-circle fa-2x d-block mb-1"></i>
                            FAILED
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Remarks & Observations</label>
                    <textarea class="form-control" name="remarks" rows="3" required placeholder="Describe appearance, texture, taste, or defects..."></textarea>
                </div>

                <div class="section-divider mb-4">
                    <hr class="text-muted opacity-25" />
                    <small class="bg-white px-2 text-muted fw-bold text-uppercase" style="margin-top: -30px; display: inline-block;">Optional: Log Wastage</small>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Defective Qty (Wastage)</label>
                        <div class="input-group">
                            <input type="number" name="wastageQty" class="form-control" step="0.01" min="0" placeholder="0.00">
                            <span class="input-group-text bg-light">PCS</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Wastage Reason</label>
                        <select class="form-select" name="wastageReason">
                            <option value="">Select Reason...</option>
                            <option>Substandard Size</option>
                            <option>Overbaked/Burnt</option>
                            <option>Filling Leakage</option>
                            <option>Contamination</option>
                            <option>Shape Deformity</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow">
                    <i class="fas fa-save me-2"></i>Submit Report
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const inspectionModal = new bootstrap.Modal(document.getElementById('inspectionModal'));
        
        function openInspectionModal(id, productName, qty) {
            document.getElementById('modalOrderId').value = id;
            document.getElementById('modalProductName').innerText = productName;
            document.getElementById('modalBatchId').innerText = '#PROD-' + String(id).padStart(4, '0');
            inspectionModal.show();
        }
    </script>
}

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
    .italic { font-style: italic; }
    .card { border-radius: 1rem; }
</style>
