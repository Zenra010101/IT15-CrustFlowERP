@model IEnumerable<CrustFlowERP.Models.Production.Product>
@{
    ViewData["Title"] = "Recipes Management";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div class="page-title-box">
                <h3 class="mb-0 fw-bold"><i class="fas fa-utensils me-2 text-primary"></i> Recipes Master List</h3>
                <p class="text-muted">Manage ingredients and formulas for all baked goods.</p>
            </div>
            <div>
                <a asp-controller="Products" asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                    <i class="fas fa-plus me-2"></i> New Product
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stats for Recipes -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px; border-left: 5px solid #28a745;">
                <div class="card-body py-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-success-subtle p-3 rounded-3 me-3">
                            <i class="fas fa-bread-slice fa-2x text-success"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">@Model.Count()</h4>
                            <p class="text-muted mb-0">Total Products</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px; border-left: 5px solid #17a2b8;">
                <div class="card-body py-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-info-subtle p-3 rounded-3 me-3">
                            <i class="fas fa-mortar-pestle fa-2x text-info"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">@Model.Sum(p => p.Recipes.Count)</h4>
                            <p class="text-muted mb-0">Total Formulations</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px; border-left: 5px solid #f39c12;">
                <div class="card-body py-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning-subtle p-3 rounded-3 me-3">
                            <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">@Model.Count(p => !p.Recipes.Any())</h4>
                            <p class="text-muted mb-0">Products Missing Recipes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Products with Recipes Table -->
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-th-list me-2 text-primary"></i>
                        <h5 class="mb-0 fw-bold">Formula Library</h5>
                        <div class="ms-auto">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-search"></i></span>
                                <input type="text" class="form-control bg-light border-0" placeholder="Search products..." id="recipeSearch">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4" style="width: 30%;">Product</th>
                                    <th>Category</th>
                                    <th>Ingredients Count</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="recipeList">
                                @foreach (var product in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary-subtle p-2 rounded-2 me-3">
                                                    <i class="fas fa-box text-primary"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@product.Name</div>
                                                    <small class="text-muted">ID: #PRO-@product.Id.ToString("D4")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark fw-normal rounded-pill px-3 py-2 border">
                                                @product.Category
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-primary">@product.Recipes.Count</span> ingredients
                                        </td>
                                        <td>
                                            @if (product.Recipes.Any())
                                            {
                                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-medium">
                                                    <i class="fas fa-check-circle me-1"></i> Ready
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-medium">
                                                    <i class="fas fa-times-circle me-1"></i> Missing
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-action="Manage" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary rounded-start-pill px-3">
                                                    <i class="fas fa-cog me-1"></i> Manage
                                                </a>
                                                <button type="button" class="btn btn-sm btn-primary rounded-end-pill px-3" onclick="toggleDetails(@product.Id)">
                                                    <i class="fas fa-eye me-1"></i> Details
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <!-- Detail Row -->
                                    <tr id="details-@product.Id" style="display: none;" class="bg-light">
                                        <td colspan="5" class="py-4 ps-5 pe-4">
                                            <div class="card border-0 shadow-sm mb-0">
                                                <div class="card-body">
                                                    <h6 class="fw-bold mb-3 border-bottom pb-2">Recipe Composition for @product.Name</h6>
                                                    @if (product.Recipes.Any())
                                                    {
                                                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                                                            @foreach (var step in product.Recipes)
                                                            {
                                                                <div class="col">
                                                                    <div class="d-flex justify-content-between p-2 rounded bg-light border-start border-primary border-4">
                                                                        <span class="fw-medium">@step.Ingredient?.Name</span>
                                                                        <span class="badge bg-primary rounded-pill">@step.QuantityRequired @step.Ingredient?.Unit</span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-warning mb-0">
                                                            <i class="fas fa-exclamation-circle me-2"></i> No recipe defined for this product yet.
                                                            <a asp-action="Manage" asp-route-id="@product.Id" class="alert-link ms-2">Add components now</a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDetails(id) {
            const row = document.getElementById('details-' + id);
            if (row.style.display === 'none') {
                row.style.display = 'table-row';
            } else {
                row.style.display = 'none';
            }
        }

        $(document).ready(function() {
            $("#recipeSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#recipeList tr:not([id^='details-'])").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}

<style>
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1); }
    .bg-info-subtle { background-color: rgba(13, 202, 240, 0.1); }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1); }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1); }
    .rounded-start-pill { border-top-left-radius: 50rem !important; border-bottom-left-radius: 50rem !important; }
    .rounded-end-pill { border-top-right-radius: 50rem !important; border-bottom-right-radius: 50rem !important; }
    .fw-medium { font-weight: 500; }
</style>
