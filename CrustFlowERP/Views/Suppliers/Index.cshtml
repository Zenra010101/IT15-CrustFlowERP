@model IEnumerable<CrustFlowERP.Models.CRM.Supplier>
@using CrustFlowERP.Models
@{
    ViewData["Title"] = "Suppliers Management";
}

<style>
    :root {
        --supplier-primary: #4e73df;
        --supplier-secondary: #858796;
        --supplier-success: #1cc88a;
        --card-border-radius: 16px;
    }

    .supplier-card {
        border-radius: var(--card-border-radius);
        border: none;
        transition: all 0.3s ease;
    }

    .supplier-table thead th {
        background-color: #f8f9fc;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05rem;
        color: var(--supplier-secondary);
        border-top: none;
        padding: 1.25rem 1rem;
    }

    .supplier-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .supplier-table tbody tr:hover {
        background-color: #f8f9fc;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: all 0.2s;
        border: 1px solid #e3e6f0;
        color: var(--supplier-secondary);
        background: white;
    }

    .action-btn:hover {
        background-color: var(--supplier-primary);
        color: white;
        border-color: var(--supplier-primary);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(78, 115, 233, 0.2);
    }

    .action-btn.btn-details:hover {
        background-color: #36b9cc;
        border-color: #36b9cc;
    }

    .category-chip {
        background-color: #eef2ff;
        color: #4338ca;
        padding: 0.35rem 0.85rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .avatar-placeholder {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, var(--supplier-primary) 0%, #224abe 100%);
        box-shadow: 0 4px 10px rgba(78, 115, 223, 0.2);
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-extrabold text-dark mb-1">Suppliers Directory</h2>
            <p class="text-muted mb-0">Manage and monitor your strategic supply partners.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg rounded-4 px-4 shadow-sm fw-bold d-flex align-items-center gap-2">
            <i class="fas fa-plus"></i>
            <span>Register New Supplier</span>
        </a>
    </div>

    <!-- Quick Insights -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card supplier-card shadow-sm h-100 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                        <i class="fas fa-building text-primary fa-lg"></i>
                    </div>
                    <div>
                        <small class="text-uppercase fw-bold text-muted small d-block mb-1">Total Network</small>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card supplier-card shadow-sm h-100 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-4 me-3">
                        <i class="fas fa-check-double text-success fa-lg"></i>
                    </div>
                    <div>
                        <small class="text-uppercase fw-bold text-muted small d-block mb-1">Active Partners</small>
                        <h3 class="fw-bold mb-0">@Model.Count(s => s.IsActive)</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Suppliers Table Card -->
    <div class="card supplier-card shadow-sm bg-white overflow-hidden">
        <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Global Partners List</h5>
            <div class="input-group" style="width: 300px;">
                <span class="input-group-text bg-light border-end-0 border-0 rounded-start-pill ps-3">
                    <i class="fas fa-search text-muted small"></i>
                </span>
                <input type="text" class="form-control bg-light border-0 rounded-end-pill py-2" placeholder="Search suppliers...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table align-middle supplier-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Company Details</th>
                        <th>Classification</th>
                        <th>Core Supply</th>
                        <th>Key Contact</th>
                        <th>Status</th>
                        <th class="text-center pe-4">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-placeholder me-3">
                                        @supplier.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@supplier.Name</div>
                                        <small class="text-muted"><i class="fas fa-location-dot me-1"></i> @supplier.Address</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="category-chip">@supplier.Category</span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">
                                    <i class="fas fa-box-open text-primary opacity-50 me-2"></i>@supplier.MainProductType
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark small">@supplier.ContactName</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">@supplier.Email</span>
                                </div>
                            </td>
                            <td>
                                @if (supplier.IsActive)
                                {
                                    <span class="status-badge bg-success bg-opacity-10 text-success">
                                        <i class="fas fa-circle-check me-1"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge bg-danger bg-opacity-10 text-danger">
                                        <i class="fas fa-circle-xmark me-1"></i> Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@supplier.Id" class="action-btn btn-details" title="View Profile">
                                        <i class="fas fa-id-card-clip"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@supplier.Id" class="action-btn" title="Edit Supplier">
                                        <i class="fas fa-pen-to-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-5">
                                    <i class="fas fa-truck-ramp-box fa-4x text-light mb-3"></i>
                                    <h4 class="text-muted">No suppliers found</h4>
                                    <p class="text-secondary small">Start by adding your first strategic partner to the network.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="card-footer bg-white py-3 px-4 border-0 border-top">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing <strong>@Model.Count()</strong> partners globally</small>
                <nav aria-label="Table navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link border-0 bg-transparent text-muted" href="#">Previous</a></li>
                        <li class="page-item active"><a class="page-link rounded-circle mx-1 border-0" href="#">1</a></li>
                        <li class="page-item"><a class="page-link border-0 bg-transparent text-primary" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simple client-side search
            $(".form-control").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".supplier-table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
