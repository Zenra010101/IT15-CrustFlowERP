@{
    ViewData["Title"] = "Production Staff Dashboard";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h3 class="fw-bold text-dark">Production Staff Dashboard</h3>
                <p class="text-muted">Manage real-time production tasks and logs.</p>
            </div>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="py-5">
                    <i class="fas fa-bread-slice fa-4x text-warning opacity-25 mb-4"></i>
                    <h2 class="text-dark fw-bold">Workstation Ready</h2>
                    <p class="text-muted mx-auto" style="max-width: 500px;">
                        Start your production shift by viewing the latest orders. Your production logs and quality check notifications will appear here.
                    </p>
                    <div class="mt-4">
                        <a href="#" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark shadow-sm">View Production Orders</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
