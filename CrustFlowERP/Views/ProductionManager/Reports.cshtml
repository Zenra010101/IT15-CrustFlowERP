@{
    ViewData["Title"] = "Production Performance Reports";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-6 fw-bold"><i class="fas fa-chart-bar me-2 text-primary"></i>Production KPIs</h2>
            <p class="text-muted">Analysis of production efficiency, quality, and wastage over the last 30 days.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Efficiency Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="avatar-md bg-primary-soft rounded-circle p-3">
                        <i class="fas fa-tachometer-alt fa-2x text-primary"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Live Data</span>
                </div>
                <h6 class="text-muted small text-uppercase fw-bold">Efficiency Rate</h6>
                <h2 class="fw-bold mb-1">@(((decimal)ViewBag.EfficiencyRate).ToString("F1"))%</h2>
                <p class="text-muted small mb-0">Actual vs Planned Yield</p>
                <div class="progress mt-3" style="height: 8px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @ViewBag.EfficiencyRate%"></div>
                </div>
            </div>
        </div>

        <!-- Quality Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="avatar-md bg-success-soft rounded-circle p-3">
                        <i class="fas fa-check-double fa-2x text-success"></i>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">Quality Control</span>
                </div>
                <h6 class="text-muted small text-uppercase fw-bold">Pass Rate</h6>
                <h2 class="fw-bold mb-1">@(((decimal)ViewBag.QualityPassRate).ToString("F1"))%</h2>
                <p class="text-muted small mb-0">Successful Quality Checks</p>
                <div class="progress mt-3" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @ViewBag.QualityPassRate%"></div>
                </div>
            </div>
        </div>

        <!-- Wastage Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="avatar-md bg-danger-soft rounded-circle p-3">
                        <i class="fas fa-trash-alt fa-2x text-danger"></i>
                    </div>
                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Loss Mitigation</span>
                </div>
                <h6 class="text-muted small text-uppercase fw-bold">Wastage %</h6>
                <h2 class="fw-bold mb-1">@(((decimal)ViewBag.WastagePercentage).ToString("F1"))%</h2>
                <p class="text-muted small mb-0">Of Total Production Volume</p>
                <div class="progress mt-3" style="height: 8px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @ViewBag.WastagePercentage%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
</style>
