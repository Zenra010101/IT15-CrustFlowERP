@model IEnumerable<CrustFlowERP.Models.Production.ProductionOrder>
@using CrustFlowERP.Models.Production

@{
    ViewData["Title"] = "Manufacturing Schedule - CrustFlowERP";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --prod-glass: rgba(255, 255, 255, 0.8);
        --prod-border: rgba(255, 255, 255, 0.4);
    }

    .prod-header {
        background: var(--prod-glass);
        backdrop-filter: blur(20px);
        border: 1px solid var(--prod-border);
        border-radius: 32px;
        padding: 40px;
    }

    .table-luxury {
        border-collapse: separate;
        border-spacing: 0 16px;
    }

    .table-luxury tr {
        background: white;
        border-radius: 24px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .table-luxury tr:hover {
        transform: scale(1.005);
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .table-luxury td {
        padding: 24px;
        border: none;
        vertical-align: middle;
    }

    .table-luxury td:first-child { border-radius: 24px 0 0 24px; }
    .table-luxury td:last-child { border-radius: 0 24px 24px 0; }

    .status-badge-elite {
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .search-orb {
        background: white;
        border-radius: 50px;
        padding: 12px 28px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 450px;
    }

    .search-orb input {
        border: none;
        outline: none;
        padding-left: 15px;
        width: 100%;
        font-weight: 600;
        color: #1e293b;
    }

    .btn-action-elite {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        border: none;
        background: #f1f5f9;
        color: #475569;
    }

    .btn-action-elite:hover {
        background: #1e293b;
        color: white;
        transform: rotate(15deg);
    }

    @@media (max-width: 768px) {
        .prod-header { padding: 25px; border-radius: 24px; }
    }
</style>

<div class="container-fluid py-4 px-lg-5">
    <!-- Sophisticated Header -->
    <div class="row align-items-center mb-5 animate__animated animate__fadeIn">
        <div class="col-lg-7">
            <h1 class="fw-bold text-dark display-5 mb-1" style="letter-spacing: -2px;">Manufacturing Schedule</h1>
            <p class="text-secondary lead mb-0">Production Synchronization & Queue Management</p>
        </div>
        <div class="col-lg-5 text-lg-end mt-4 mt-lg-0 d-flex flex-column flex-lg-row justify-content-lg-end gap-3 align-items-center">
            <div class="search-orb">
                <i class="fas fa-search text-muted"></i>
                <input type="text" id="prodSearch" placeholder="Search orders, products..." onkeyup="filterOrders()">
            </div>
            @if (Context.Session.GetInt32("UserRole") != 11)
            {
                <a asp-action="Create" class="btn btn-dark rounded-pill px-5 py-3 fw-bold shadow-lg">
                    <i class="fas fa-plus-circle me-2"></i> Schedule Order
                </a>
            }
        </div>
    </div>

    <!-- Live Queue Table -->
    <div class="table-responsive">
        <table class="table-luxury w-100" id="prodTable">
            <thead>
                <tr class="text-secondary fw-bold small text-uppercase" style="letter-spacing: 1px;">
                    <th class="ps-4">Order Entity</th>
                    <th>Product Configuration</th>
                    <th class="text-center">Planned Capacity</th>
                    <th>Temporal window</th>
                    <th class="text-center">Operational State</th>
                    <th class="text-end pe-4">Command</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    string colorClass = item.Status switch {
                        ProductionStatus.Planned => "bg-primary bg-opacity-10 text-primary",
                        ProductionStatus.InProgress => "bg-warning bg-opacity-10 text-warning",
                        ProductionStatus.Completed => "bg-success bg-opacity-10 text-success",
                        ProductionStatus.Cancelled => "bg-danger bg-opacity-10 text-danger",
                        _ => "bg-light text-secondary"
                    };
                    
                    <tr class="animate__animated animate__fadeIn">
                        <td class="ps-4">
                            <div class="fw-bold text-dark">#PROD-@item.Id.ToString("D4")</div>
                            <div class="small text-muted mt-1">Registry Entry</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary">
                                    <i class="fas fa-industry"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark mb-0">@item.Product?.Name</div>
                                    <div class="smaller text-muted">@item.Product?.Category</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="fw-bold text-dark h5 mb-0">@item.QuantityPlanned.ToString("N0")</div>
                            <div class="small text-muted">Units</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark small">@item.ScheduledStart.ToString("MMM dd, yyyy")</div>
                            <div class="smaller text-muted mt-1">@item.ScheduledStart.ToString("hh:mm tt")</div>
                        </td>
                        <td class="text-center">
                            <span class="status-badge-elite @colorClass">
                                <i class="fas fa-dot-circle small"></i> @item.Status
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn-action-elite" title="Quick View" onclick="openOrderModal(@item.Id)">
                                    <i class="fas fa-expand-alt"></i>
                                </button>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action-elite" title="Track Progress">
                                    <i class="fas fa-chart-line"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Elite Modal Container -->
<div class="modal fade" id="orderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content overflow-hidden border-0 shadow-lg" style="border-radius: 32px;" id="modalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-4 text-muted fw-bold">Synchronizing details...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterOrders() {
            let input = document.getElementById('prodSearch');
            let filter = input.value.toUpperCase();
            let table = document.getElementById('prodTable');
            let tr = table.getElementsByTagName('tr');

            for (let i = 1; i < tr.length; i++) {
                let text = tr[i].textContent || tr[i].innerText;
                if (text.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }

        function openOrderModal(id) {
            const modal = new bootstrap.Modal(document.getElementById('orderModal'));
            const content = document.getElementById('modalContent');
            content.innerHTML = `<div class="modal-body text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>`;
            modal.show();

            fetch(`/ProductionOrders/GetOrderDetailsContent/${id}`)
                .then(response => response.text())
                .then(html => content.innerHTML = html);
        }
    </script>
}

