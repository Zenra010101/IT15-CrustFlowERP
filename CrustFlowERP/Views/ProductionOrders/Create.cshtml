@model CrustFlowERP.Models.Production.ProductionOrder
@{
    ViewData["Title"] = "Schedule Production";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Production Orders</a></li>
                    <li class="breadcrumb-item active">Schedule New</li>
                </ol>
            </nav>
            <h3 class="fw-bold"><i class="fas fa-calendar-plus text-primary me-2"></i> Schedule Production Run</h3>
            <p class="text-muted">Plan a new baking batch for a specific product.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Select Product</label>
                                <select asp-for="ProductId" class="form-select border-1 bg-white shadow-sm fw-bold text-dark" asp-items="ViewBag.ProductId" required style="border-radius: 10px; height: 60px;">
                                    <option value="">-- Choose Product --</option>
                                </select>
                                <span asp-validation-for="ProductId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Quantity Planned</label>
                                <div class="input-group shadow-sm">
                                    <input asp-for="QuantityPlanned" type="number" step="0.01" class="form-control border-1 bg-white fw-bold text-dark fs-5" placeholder="0.00 units" required style="border-top-left-radius: 10px; border-bottom-left-radius: 10px; height: 60px; padding-left: 15px;">
                                    <span class="input-group-text bg-light border-1 fw-bold text-muted" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px; min-width: 80px; justify-content: center;">Units</span>
                                </div>
                                <span asp-validation-for="QuantityPlanned" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Scheduled Start</label>
                                <input asp-for="ScheduledStart" type="datetime-local" class="form-control border-1 bg-white shadow-sm fw-bold text-dark" required style="border-radius: 10px; height: 60px;" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                                <span asp-validation-for="ScheduledStart" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Production Notes</label>
                                <textarea asp-for="Notes" class="form-control border-1 bg-white shadow-sm" rows="3" placeholder="Additional instructions for the bakery staff..." style="border-radius: 10px;"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> Schedule Batch
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm bg-info text-white" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-lightbulb me-2"></i> Planning Tip</h5>
                    <p class="mb-0">Ensure that your inventory has enough ingredients before scheduling a large production run. You can check the <strong>Inventory</strong> tab to verify stock levels.</p>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm mt-4" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">Recent Schedules</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-history fa-2x mb-2 opacity-50"></i>
                            <p class="small mb-0">View recently created orders in the main list.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
