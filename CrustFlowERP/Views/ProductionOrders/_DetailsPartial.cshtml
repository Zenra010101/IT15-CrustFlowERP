@model CrustFlowERP.Models.Production.ProductionOrder

<div class="modal-header border-0 pb-0">
    <h5 class="modal-title fw-bold" id="orderModalLabel">
        <i class="fas fa-barcode text-primary me-2"></i> Order #PROD-@Model.Id.ToString("D4")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body pt-4">
    <div class="row g-4">
        <!-- Main Stats -->
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100">
                <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-1">Product</small>
                <h5 class="fw-bold mb-1">@Model.Product?.Name</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small rounded-pill">
                    @Model.Product?.Category
                </span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100">
                <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-1">Status</small>
                @{
                    string statusClass = Model.Status switch {
                        CrustFlowERP.Models.Production.ProductionStatus.Planned => "text-info",
                        CrustFlowERP.Models.Production.ProductionStatus.InProgress => "text-primary",
                        CrustFlowERP.Models.Production.ProductionStatus.Completed => "text-success",
                        _ => "text-secondary"
                    };
                }
                <h4 class="fw-bold @statusClass mb-0">
                    <i class="fas fa-circle-check me-2"></i> @Model.Status
                </h4>
            </div>
        </div>

        <!-- Schedule -->
        <div class="col-md-4">
            <div class="p-3 border rounded-3 text-center">
                <i class="fas fa-calendar-alt text-muted mb-2 fa-2x opacity-50"></i>
                <small class="d-block text-muted small">Scheduled For</small>
                <div class="fw-bold">@Model.ScheduledStart.ToString("MMM dd, yyyy")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded-3 text-center">
                <i class="fas fa-clock text-muted mb-2 fa-2x opacity-50"></i>
                <small class="d-block text-muted small">Start Time</small>
                <div class="fw-bold">@Model.ActualStart?.ToString("hh:mm tt")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded-3 text-center">
                <i class="fas fa-hourglass-end text-muted mb-2 fa-2x opacity-50"></i>
                <small class="d-block text-muted small">End Time</small>
                <div class="fw-bold">@Model.ActualEnd?.ToString("hh:mm tt")</div>
            </div>
        </div>

        <!-- Quantities -->
        <div class="col-12">
            <div class="card border-0 bg-dark text-white p-3 mb-2" style="border-radius: 12px;">
                <div class="row align-items-center">
                    <div class="col-5 text-center">
                        <small class="opacity-75 d-block">Planned</small>
                        <h3 class="mb-0 fw-bold">@Model.QuantityPlanned.ToString("N2")</h3>
                    </div>
                    <div class="col-2 text-center text-primary">
                        <i class="fas fa-arrow-right fa-2x opacity-50"></i>
                    </div>
                    <div class="col-5 text-center">
                        <small class="opacity-75 d-block">Actual</small>
                        <h3 class="mb-0 fw-bold text-success">@Model.QuantityActual.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Product?.Recipes != null && Model.Product.Recipes.Any())
        {
            <div class="col-12">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold letter-spacing-1 d-block mb-2">Recipe Highlights (Planned Batch)</small>
                    <div class="row g-2">
                        @foreach (var recipe in Model.Product.Recipes.Take(4))
                        {
                            var needed = recipe.QuantityRequired * Model.QuantityPlanned;
                            <div class="col-6">
                                <div class="small fw-bold">@recipe.Ingredient?.Name</div>
                                <div class="text-primary small">@needed.ToString("N2") @recipe.Ingredient?.Unit</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12">
                <div class="p-3 bg-warning-subtle rounded-3 border border-warning-subtle">
                    <small class="fw-bold text-warning-emphasis d-block mb-1"><i class="fas fa-sticky-note me-2"></i> Notes</small>
                    <p class="mb-0 small text-dark">@Model.Notes</p>
                </div>
            </div>
        }
    </div>
</div>
<div class="modal-footer border-0 d-flex gap-2">
    <button type="button" class="btn btn-light border border-secondary border-1 rounded-pill px-4" data-bs-dismiss="modal">Close</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary border border-primary border-1 rounded-pill px-4 shadow-sm">
        Full Tracking View <i class="fas fa-arrow-right ms-2"></i>
    </a>
</div>

<style>
    .letter-spacing-1 { letter-spacing: 0.5px; }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1); }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1); }
</style>
