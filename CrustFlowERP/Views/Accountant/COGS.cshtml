@{
    ViewData["Title"] = "COGS Analysis";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold"><i class="fas fa-tags me-2 text-danger"></i>Cost of Goods Sold (COGS)</h2>
            <p class="text-muted">Analyze the direct costs of producing your products.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <p class="text-muted small mb-1">Total COGS (MTD)</p>
                <h3 class="fw-bold text-danger">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <p class="text-muted small mb-1">Ingredient Costs</p>
                <h3 class="fw-bold text-dark">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <p class="text-muted small mb-1">Wastage Impact</p>
                <h3 class="fw-bold text-warning">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <p class="text-muted small mb-1">Gross Margin</p>
                <h3 class="fw-bold text-success">0%</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Recent Product Costings</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Product</th>
                            <th>Category</th>
                            <th>Unit Cost</th>
                            <th>Selling Price</th>
                            <th>Gross Profit</th>
                            <th class="pe-4 text-end">Margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-chart-bar fa-3x mb-3 opacity-25"></i>
                                <p>No costing data available yet.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
