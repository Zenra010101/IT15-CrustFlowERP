@{
    ViewData["Title"] = "Expenses & Profits";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h2 class="display-6"><i class="fas fa-coins me-2 text-indigo"></i>Expenses & Profits</h2>
            <p class="text-muted">Analyze your net income and fixed/variable expenses.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-indigo p-4 text-center text-white">
                <p class="small mb-1 opacity-75">Net Income (MTD)</p>
                <h3 class="fw-bold mt-2">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Fixed Expenses</p>
                <h3 class="text-danger fw-bold mt-2">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Operating Costs</p>
                <h3 class="text-warning fw-bold mt-2">₱0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 text-center">
                <p class="text-muted small mb-1">Profit Margin</p>
                <h3 class="text-success fw-bold mt-2">0%</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold">Recent Expense Ledger</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th class="text-end pe-4">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fas fa-file-invoice fa-2x mb-2 opacity-25"></i>
                                        <p>No expenses recorded recently.</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100 bg-white">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold">Profit Breakdown</h5>
                </div>
                <div class="card-body p-4">
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-chart-pie fa-4x mb-3 opacity-25"></i>
                        <p>Detailed analysis will appear here.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-indigo { background-color: #6610f2; }
    .text-indigo { color: #6610f2; }
</style>
