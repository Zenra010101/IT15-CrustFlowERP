@{
    ViewData["Title"] = "Accountant Dashboard";
    Layout = "~/Views/Shared/_AdminSidebarLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h3 class="fw-bold text-dark">Financial & Accounting Dashboard</h3>
                <p class="text-muted">Manage company ledgers, payroll, and financial auditing.</p>
            </div>
        </div>
    </div>
    
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <i class="fas fa-chart-line text-primary mb-2 h2"></i>
                <p class="text-muted small mb-1">Moy. Revenue</p>
                <h4 class="fw-bold text-dark">₱0.00</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <i class="fas fa-hand-holding-usd text-success mb-2 h2"></i>
                <p class="text-muted small mb-1">Net Profits</p>
                <h4 class="fw-bold text-dark">₱0.00</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <i class="fas fa-file-invoice text-danger mb-2 h2"></i>
                <p class="text-muted small mb-1">Pending Invoices</p>
                <h4 class="fw-bold text-dark">0</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <i class="fas fa-money-check text-warning mb-2 h2"></i>
                <p class="text-muted small mb-1">Upcoming Payroll</p>
                <h4 class="fw-bold text-dark">₱0.00</h4>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4 text-center hover-scale transition-all">
                <div class="mb-3 text-danger"><i class="fas fa-tags fa-3x"></i></div>
                <h5 class="fw-bold">COGS Analysis</h5>
                <p class="text-muted small">Analyze production costs and ingredient wastage.</p>
                <a asp-action="COGS" class="btn btn-danger btn-sm rounded-pill px-4 mt-auto">Detail Analysis</a>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4 text-center hover-scale transition-all">
                <div class="mb-3 text-primary"><i class="fas fa-money-check-alt fa-3x"></i></div>
                <h5 class="fw-bold">Payroll</h5>
                <p class="text-muted small">Manage employee salaries and remittances.</p>
                <a asp-action="Payroll" class="btn btn-primary btn-sm rounded-pill px-4 mt-auto">Process Payroll</a>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4 text-center hover-scale transition-all">
                <div class="mb-3 text-indigo"><i class="fas fa-coins fa-3x"></i></div>
                <h5 class="fw-bold">Expenses & Profits</h5>
                <p class="text-muted small">Track operating costs and net income margins.</p>
                <a asp-action="ExpensesProfits" class="btn btn-indigo btn-sm rounded-pill px-4 mt-auto text-white">Full Report</a>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4 text-center hover-scale transition-all">
                <div class="mb-3 text-warning"><i class="fas fa-file-invoice-dollar fa-3x"></i></div>
                <h5 class="fw-bold">Financial Reports</h5>
                <p class="text-muted small">Generate balance sheets and audit statements.</p>
                <a asp-action="FinancialReports" class="btn btn-warning btn-sm rounded-pill px-4 mt-auto">Open Center</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="mb-0 fw-bold">Recent Financial Activity</h5>
        </div>
        <div class="card-body p-4 text-center text-muted py-5">
            <i class="fas fa-history fa-4x mb-3 opacity-25"></i>
            <p>Financial activity logs will begin appearing here once transactions are recorded.</p>
        </div>
    </div>
</div>

<style>
    .bg-indigo { background-color: #6610f2; }
    .text-indigo { color: #6610f2; }
    .btn-indigo { background-color: #6610f2; border-color: #6610f2; }
    .transition-all { transition: all 0.3s ease; }
    .hover-scale { border: 1px solid transparent !important; }
    .hover-scale:hover { transform: translateY(-5px); border-color: rgba(0,0,0,0.05) !important; box-shadow: 0 10px 30px rgba(0,0,0,0.05) !important; }
</style>
