@model CrustFlowERP.Models.Production.Inventory
@{
    ViewData["Title"] = "Edit Stock Record";
    Layout = "_AdminSidebarLayout";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
                    <li class="breadcrumb-item active">Edit Stock</li>
                </ol>
            </nav>
            <h3 class="fw-bold"><i class="fas fa-edit text-primary me-2"></i> Edit Inventory Record</h3>
            <p class="text-muted">Update stock quantity, expiration date, or category details.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ReceivedDate" />
                        <input type="hidden" asp-for="BatchQuantity" />
                        
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Item Name</label>
                                <select asp-for="IngredientId" class="form-select border-0 bg-light" asp-items="ViewBag.IngredientId" style="border-radius: 10px; height: 45px;">
                                </select>
                                <span asp-validation-for="IngredientId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Supplier Source</label>
                                <select asp-for="Supplier" class="form-select border-0 bg-light" asp-items="ViewBag.SupplierId" style="border-radius: 10px; height: 45px;">
                                    <option value="">-- No Supplier --</option>
                                </select>
                                <span asp-validation-for="Supplier" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Batch Number</label>
                                <input asp-for="BatchNumber" class="form-control border-0 bg-light" style="border-radius: 10px; height: 45px;" readonly>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Remaining Stock</label>
                                <div class="input-group">
                                    <input asp-for="RemainingQuantity" type="number" step="0.0001" class="form-control border-0 bg-light" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px; height: 45px;">
                                    <span class="input-group-text bg-light border-0" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;">@Model.Ingredient?.Unit</span>
                                </div>
                                <span asp-validation-for="RemainingQuantity" class="text-danger small"></span>
                                <small class="text-muted">Initial: @Model.BatchQuantity @Model.Ingredient?.Unit</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Expiration Date</label>
                                <input asp-for="ExpirationDate" type="date" class="form-control border-0 bg-light" style="border-radius: 10px; height: 45px;" value="@Model.ExpirationDate.ToString("yyyy-MM-dd")">
                                <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Category</label>
                                <select asp-for="Category" class="form-select border-0 bg-light" asp-items="Html.GetEnumSelectList<CrustFlowERP.Models.InventoryCategory>()" style="border-radius: 10px; height: 45px;">
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> Update Record
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
