@model List<CrustFlowERP.Models.SystemActivity>
@{
    ViewData["Title"] = "System Logs";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">System Activity Logs</h2>
            <p class="text-muted">Complete history of ERP transactions and staff activities</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (ViewBag.LogError != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Data Sync Issue</h5>
            <p class="mb-0">There was an error retrieving some log entries: @ViewBag.LogError</p>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">Recent Activities</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-light border" onclick="window.print()">
                    <i class="fas fa-print me-1"></i> Print Report
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User / Module</th>
                            <th>Action Details</th>
                            <th>Timestamp</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var activity in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="profile-avatar sm me-2" style="width:32px;height:32px;font-size:0.8rem; background: #8b5a2b; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                @(activity.User?.Length >= 2 ? activity.User.Substring(0, 2).ToUpper() : "SY")
                                            </div> 
                                            <div>
                                                <div class="fw-bold">@activity.User</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@activity.Action</td>
                                    <td>
                                        <div class="fw-bold">@activity.Timestamp.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@activity.Timestamp.ToString("hh:mm tt")</small>
                                    </td>
                                    <td><span class="badge @activity.BadgeClass px-3 py-2">@activity.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-history fa-3x mb-3 opacity-25"></i>
                                        <p>No system activity logs found in the selected period.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-soft-success { background-color: #d1e7dd; color: #0f5132; }
    .badge-soft-info { background-color: #cff4fc; color: #055160; }
    .badge-soft-warning { background-color: #fff3cd; color: #664d03; }
    .badge-soft-danger { background-color: #f8d7da; color: #842029; }
</style>
