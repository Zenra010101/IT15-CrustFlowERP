@model IEnumerable<CrustFlowERP.Models.UserViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box d-flex justify-content-between align-items-center">
                <div>
                    <h3>User Management</h3>
                    <p>Manage system users, search, and perform administrative actions.</p>
                </div>
                <div>
                    <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
                        <i class="fas fa-user-plus me-2"></i> Add new Admin
                    </button>
                    <button class="btn btn-outline-secondary ms-2" onclick="location.reload()">
                        <i class="fas fa-sync-alt me-2"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <div class="table-card mb-4">
                <div class="p-4 border-bottom bg-white">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" placeholder="Search users by name, email..." id="userSearch">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="roleFilter">
                                <option value="">Filter by Role</option>
                                <option value="SuperAdmin">1. Super Admin</option>
                                <option value="Admin">2. Admin</option>
                                <option value="Production Manager">3. Production Manager</option>
                                <option value="Production Staff">4. Production Staff</option>
                                <option value="Quality Control Staff">5. Quality Control Staff</option>
                                <option value="Warehouse Staff">6. Warehouse Staff</option>
                                <option value="Purchasing Officer">7. Purchasing Officer</option>
                                <option value="Cashier">8. Cashier</option>
                                <option value="Sales Manager">9. Sales Manager</option>
                                <option value="Accountant">10. Accountant</option>
                                <option value="Manager">11. Manager</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="statusFilter">
                                <option value="">Filter by Status</option>
                                <option value="Active">Active</option>
                                <option value="Deactivated">Deactivated</option>
                                <option value="Revoked">Revoked</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40%;">User</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="profile-avatar me-3">@(!string.IsNullOrEmpty(user.Email) ? user.Email[0].ToString().ToUpper() : "U")</div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@user.UserName</h6>
                                                <small class="text-muted">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = user.RoleName switch
                                            {
                                                "SuperAdmin" => "badge-soft-danger",
                                                "Admin" => "badge-soft-primary",
                                                "Production Manager" => "badge-soft-info",
                                                "Production Staff" => "badge-soft-secondary",
                                                "Quality Control Staff" => "badge-soft-warning",
                                                "Warehouse Staff" => "badge-soft-dark",
                                                "Purchasing Officer" => "badge-soft-purple",
                                                "Cashier" => "badge-soft-teal",
                                                "Sales Manager" => "badge-soft-pink",
                                                "Accountant" => "badge-soft-success",
                                                "Manager" => "badge-soft-primary",
                                                _ => "badge-soft-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@user.RoleName</span>
                                    </td>
                                    <td>
                                        @{
                                            var statusBadge = (user.Status ?? "Active").ToLower() switch
                                            {
                                                "active" => "bg-success text-white",
                                                "deactivated" => "bg-warning text-dark",
                                                "revoked" => "bg-danger text-white",
                                                _ => "bg-secondary text-white"
                                            };
                                        }
                                        <span class="badge @statusBadge">@(user.Status ?? "Active")</span>
                                    </td>
                                    <td>
                                        <div class="text-muted small">
                                            @if (user.IsLockedOut && user.LockoutEnd.HasValue)
                                            {
                                                <span>Locked until @user.LockoutEnd.Value.ToString("g")</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                             <button class="btn btn-sm btn-outline-primary" onclick="editUser('@user.Id')" title="Edit User">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            
                                            @if (user.Status != "Active")
                                            {
                                                <button class="btn btn-sm btn-outline-success" onclick="activateUser('@user.Id')" title="Activate Account">
                                                    <i class="fas fa-check-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-warning" onclick="deactivateUser('@user.Id')" title="Deactivate Account">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" onclick="revokeUser('@user.Id')" title="Revoke Access">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            }

                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('@user.Id')" title="Delete User">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info" onclick="resetPassword('@user.Id')" title="Reset Password">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" onclick="viewDetails('@user.Id')" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top py-3">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm justify-content-end mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1">Previous</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Admin User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fas fa-user-plus me-2 text-primary"></i> Add New Admin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createAdminForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" class="form-control" id="adminEmail" placeholder="admin@example.com" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" class="form-control" id="adminPassword" placeholder="Enter password" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <input type="password" class="form-control" id="adminConfirmPassword" placeholder="Confirm password" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assign Role</label>
                        <select class="form-select" id="adminRole" required>
                            <option value="2">Admin</option>
                            <option value="11">Manager</option>
                            <option value="10">Accountant</option>
                            <option value="9">Sales Manager</option>
                            <option value="8">Cashier</option>
                            <option value="7">Purchasing Officer</option>
                            <option value="6">Warehouse Staff</option>
                            <option value="5">Quality Control Staff</option>
                            <option value="4">Production Staff</option>
                            <option value="3">Production Manager</option>
                        </select>
                    </div>
                    
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="sendEmail" checked>
                        <label class="form-check-label" for="sendEmail">Send welcome email with login details</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-admin-primary px-4" onclick="createAdminUser()">Create User</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fas fa-user-edit me-2 text-primary"></i> Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" />
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Username</label>
                                <input type="text" class="form-control" id="editUserName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email Address</label>
                                <input type="email" class="form-control" id="editUserEmail" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role Assignment</label>
                        <select class="form-select" id="editUserRole" required>
                            <option value="">Select Role</option>
                            <option value="1">Super Admin</option>
                            <option value="2">Admin</option>
                            <option value="11">Manager</option>
                            <option value="10">Accountant</option>
                            <option value="9">Sales Manager</option>
                            <option value="8">Cashier</option>
                            <option value="7">Purchasing Officer</option>
                            <option value="6">Warehouse Staff</option>
                            <option value="5">Quality Control Staff</option>
                            <option value="4">Production Staff</option>
                            <option value="3">Production Manager</option>
                        </select>
                        <div class="form-text">Note: SuperAdmin users cannot be edited by other users.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account Status</label>
                        <div class="form-control-plaintext">
                            <span id="editUserStatus" class="badge bg-success text-white">
                                <i class="fas fa-check me-1"></i>Active
                            </span>
                            <small id="editUserLockoutInfo" class="d-block text-muted"></small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role Permissions</label>
                        <div id="editRolePermissions" class="alert alert-info border-0 bg-soft-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Select a role to view associated permissions.
                        </div>
                        
                        <div id="adminPermissions" style="display: none;">
                            <h6 class="fw-bold mb-3 text-primary">Admin Permissions</h6>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Create Users (Admin, Manager, Cashier)
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Edit Users (Admin, Manager, Cashier)
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Delete Users (Admin, Manager, Cashier)
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>View Reports
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Manage Inventory
                                </div>
                            </div>
                        </div>

                        <div id="managerPermissions" style="display: none;">
                            <h6 class="fw-bold mb-3 text-success">Manager Permissions</h6>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>View Reports
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Manage Inventory
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Supervise Staff
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Approve Transactions
                                </div>
                            </div>
                        </div>

                        <div id="cashierPermissions" style="display: none;">
                            <h6 class="fw-bold mb-3 text-warning">Staff Permissions</h6>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Access assigned department module
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Update task status
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>View personal dashboard
                                </div>
                            </div>
                        </div>

                        <div id="productionPermissions" style="display: none;">
                            <h6 class="fw-bold mb-3 text-info">Production Permissions</h6>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Manage production lines
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Track batch status
                                </div>
                                <div class="list-group-item px-0">
                                    <i class="fas fa-check text-success me-2"></i>Resource allocation
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-admin-primary px-4" onclick="updateUser()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/superadmin-users.js"></script>
}
